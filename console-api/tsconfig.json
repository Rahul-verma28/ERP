{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["../backend/src/contracts/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "prisma/**/*.ts"]
}
