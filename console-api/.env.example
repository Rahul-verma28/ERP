# AHEAD Console API (copy to .env and fill in)
PORT=5100
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
PEPPER=
# Encrypts two-step secrets at rest (32 bytes, base64)
MFA_KEY=
# Web apps allowed to call this API
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Licences: only the Console holds the private key
LICENCE_PRIVATE_KEY=
# The ERP installation (cloud) and the shared key for signed calls
ERP_URL=http://localhost:5000
ERP_APP_URL=http://localhost:3000
PROVISION_KEY=
DEPLOYMENT_ID=cloud-dev
# Email for invites and owner links (same mailbox as the ERP for now)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# One-time import of the businesses already in the ERP database (npm run import:erp)
ERP_DATABASE_URL=

# Where this API is reached from outside (payment pages, webhooks)
PUBLIC_URL=http://localhost:5100
# Razorpay payment links (empty in development: a built-in test gateway). Webhook: <PUBLIC_URL>/api/v1/webhooks/razorpay, event payment_link.paid
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Outside production every email goes here instead (default: SMTP_USER), so test data never mails real people
MAIL_REDIRECT_TO=
# Files (partner KYC). With S3_BUCKET set they go to S3 under console/, else to STORAGE_DIR (default console-api/storage)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# STORAGE_DIR=
