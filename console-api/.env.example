# AHEAD Console API (copy to .env and fill in)
PORT=5100
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
PEPPER=
# Encrypts two-step secrets at rest (32 bytes, base64)
MFA_KEY=
# Web apps allowed to call this API
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Licences: only the Console holds the private key
LICENCE_PRIVATE_KEY=
# The ERP installation (cloud) and the shared key for signed calls
ERP_URL=http://localhost:5000
ERP_APP_URL=http://localhost:3000
PROVISION_KEY=
DEPLOYMENT_ID=cloud-dev
# Email for invites and owner links (same mailbox as the ERP for now)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# One-time import of the businesses already in the ERP database (npm run import:erp)
ERP_DATABASE_URL=
