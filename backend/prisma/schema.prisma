// AHEAD SOFTWARE — Platform core schema (LLD v1 §3–§9)
// Conventions: snake_case tables/columns, UUID v7 ids, money as bigint paise,
// timestamptz everywhere. Tenant tables carry tenant_id and are protected by RLS
// (see migrations/*_rls/migration.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  active
  locked
  disabled

  @@map("user_status")
}

enum OtpChannel {
  sms
  whatsapp
  email

  @@map("otp_channel")
}

enum OtpPurpose {
  signup
  login
  reset
  vendor_signup
  mfa
  invite
  email_change
  mobile_change
  close_account
  portal

  @@map("otp_purpose")
}

enum TenantStatus {
  incomplete // created by sales/vendor, waiting for the first payment (design v2)
  trialing
  active
  past_due
  free
  closed
  purged

  @@map("tenant_status")
}

enum TenantSource {
  direct
  vendor
  sales
  partner

  @@map("tenant_source")
}

/// How the tenant started: self-signup trial, or created by sales/vendor and paid up front
enum OnboardingType {
  trial
  direct_paid

  @@map("onboarding_type")
}

enum AcquiredByType {
  self
  vendor
  sales_user
  partner_user

  @@map("acquired_by_type")
}

enum AcquisitionMethod {
  signup
  referral_link
  referral_code
  manual

  @@map("acquisition_method")
}

/// Which side of the app a session works in (design v2: Console + Business ERP)
enum Workspace {
  tenant
  console

  @@map("workspace")
}

enum BillingOwner {
  self
  partner

  @@map("billing_owner")
}

enum MemberStatus {
  invited
  active
  deactivated

  @@map("member_status")
}

enum PermissionAction {
  view
  create
  edit
  delete
  approve
  export

  @@map("permission_action")
}

enum RoleLayer {
  platform
  partner
  vendor
  tenant

  @@map("role_layer")
}

enum RoleType {
  admin
  user
  salesperson
  counter
  employee

  @@map("role_type")
}

enum PermissionScope {
  own
  team
  branch
  all

  @@map("permission_scope")
}

enum FieldAccess {
  hidden
  read
  write

  @@map("field_access")
}

enum FieldType {
  text
  number
  date
  dropdown
  multi_select
  checkbox
  attachment
  relation

  @@map("field_type")
}

enum RecordSource {
  template
  tenant
  sample

  @@map("record_source")
}

enum PriceItemType {
  plan
  addon_module
  extra_user
  credit_pack

  @@map("price_item_type")
}

enum BillingCycle {
  monthly
  yearly
  one_time

  @@map("billing_cycle")
}

enum CouponType {
  percent
  flat

  @@map("coupon_type")
}

enum EntitlementStatus {
  active
  read_only
  inactive

  @@map("entitlement_status")
}

// ─────────────────────── Identity & tenancy ───────────────────────

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  name              String
  email             String     @unique // stored lower-cased
  mobile            String     @unique @db.VarChar(15) // E.164
  passwordHash      String?    @map("password_hash")
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz
  mobileVerifiedAt  DateTime?  @map("mobile_verified_at") @db.Timestamptz
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  status            UserStatus @default(active)
  failedLogins      Int        @default(0) @map("failed_logins")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz
  lastTenantId      String?    @map("last_tenant_id") @db.Uuid
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz
  /// Personal theme, font, density, start page, date format (contracts/account.ts)
  preferences       Json       @default("{}")
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  avatarUrl String? @map("avatar_url")

  sessions        UserSession[]
  mfa             UserMfa?
  trustedDevices  UserTrustedDevice[]
  passwordHistory UserPasswordHistory[]
  memberships     TenantMember[]
  platformMember  PlatformMember?
  accessLinks     AccessLink[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid // tenant the session is currently working in
  workspace        Workspace @default(tenant) // console = AHEAD team workspace (tenantId is null)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("user_sessions")
}

model OtpCode {
  id         String     @id @default(uuid(7)) @db.Uuid
  target     String
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0) @db.SmallInt
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([target, purpose, createdAt(sort: Desc)])
  @@map("otp_codes")
}

model Tenant {
  id               String         @id @default(uuid(7)) @db.Uuid
  name             String
  legalName        String?        @map("legal_name")
  industryKey      String         @map("industry_key")
  templateVersion  Int            @map("template_version")
  status           TenantStatus   @default(trialing)
  source           TenantSource   @default(direct)
  onboardingType   OnboardingType @default(trial) @map("onboarding_type")
  isInternal       Boolean        @default(false) @map("is_internal")
  partnerId        String?        @map("partner_id") @db.Uuid
  billingOwner     BillingOwner   @default(self) @map("billing_owner")
  gstin            String?        @db.VarChar(15)
  billingStateCode String?        @map("billing_state_code") @db.Char(2)
  address          Json?
  logoUrl          String?        @map("logo_url")
  timezone         String         @default("Asia/Kolkata")
  fyStartMonth     Int            @default(4) @map("fy_start_month") @db.SmallInt
  ownerUserId      String         @map("owner_user_id") @db.Uuid
  needsSeatChoice  Boolean        @default(false) @map("needs_seat_choice")
  configAppliedAt  DateTime?      @map("config_applied_at") @db.Timestamptz
  onboarding       Json           @default("{}")
  /// Signup answers: business type, team size, goals … (contracts/workspace.ts WorkspaceProfile)
  profile          Json           @default("{}")
  /// Documents, payments, taxes and branding (contracts/workspace.ts WorkspacePreferences)
  preferences      Json           @default("{}")
  closedAt         DateTime?      @map("closed_at") @db.Timestamptz
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  branches     Branch[]
  members      TenantMember[]
  subscription Subscription?
  acquisition  TenantAcquisition?
  partner      Partner?           @relation(fields: [partnerId], references: [id], map: "tenants_partner_fkey")
  accessLinks  AccessLink[]

  @@index([partnerId])
  @@index([status])
  @@index([source])
  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String
  address   Json?
  stateCode String?  @map("state_code") @db.Char(2)
  gstin     String?  @db.VarChar(15)
  isDefault Boolean  @default(false) @map("is_default")
  /// Inactive: hidden from new choices, kept on old records
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("branches")
}

model TenantMember {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  roleId        String       @map("role_id") @db.Uuid
  branchIds     String[]     @default([]) @map("branch_ids") @db.Uuid
  status        MemberStatus @default(invited)
  joinedAt      DateTime?    @map("joined_at") @db.Timestamptz
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz
  version       Int          @default(1)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId, roleId])
  @@index([userId])
  @@map("tenant_members")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String?
  email      String?
  mobile     String?   @db.VarChar(15)
  roleId     String    @map("role_id") @db.Uuid
  branchIds  String[]  @default([]) @map("branch_ids") @db.Uuid
  /// For an HR employee: accepting links the login to the employee record
  employeeId String?   @map("employee_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("invitations")
}

/// Platform table (no RLS, never visible to tenants): a member of the AHEAD team in the Console.
/// reportsTo builds the sales hierarchy used by the "team" scope.
model PlatformMember {
  id            String       @id @default(uuid(7)) @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  roleId        String       @map("role_id") @db.Uuid
  reportsTo     String?      @map("reports_to") @db.Uuid // user id of the manager
  status        MemberStatus @default(active)
  createdBy     String?      @map("created_by") @db.Uuid
  joinedAt      DateTime     @default(now()) @map("joined_at") @db.Timestamptz
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz
  /// Set for partner people: they only ever see that partner's clients
  partnerId     String?      @map("partner_id") @db.Uuid
  /// Vendors and salespeople: signups with this code are credited to them
  referralCode  String?      @unique(map: "platform_members_referral_code_key") @map("referral_code") @db.VarChar(20)

  user    User     @relation(fields: [userId], references: [id])
  role    Role     @relation(fields: [roleId], references: [id])
  partner Partner? @relation(fields: [partnerId], references: [id], map: "platform_members_partner_fkey")

  @@index([reportsTo])
  @@index([partnerId], map: "platform_members_partner_idx")
  @@map("platform_members")
}

/// A reseller that brings its own clients; AHEAD bills it monthly at list price minus discountBp.
model Partner {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  contactName String   @map("contact_name")
  email       String
  mobile      String   @db.VarChar(15)
  gstin       String?  @db.VarChar(15)
  stateCode   String?  @map("state_code") @db.Char(2)
  discountBp  Int      @default(0) @map("discount_bp")
  status      String   @default("active")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  members PlatformMember[]
  tenants Tenant[]

  @@map("partners")
}

/// What a Console extension changed: the trial end (trialing) or the payment grace end (past_due)
enum ExtensionKind {
  trial
  grace

  @@map("extension_kind")
}

/// Platform table: extra days given from the Console (design v2 §3), always with a reason.
model GracePeriod {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  kind          ExtensionKind
  days          Int
  reason        String
  previousEndAt DateTime?     @map("previous_end_at") @db.Timestamptz
  newEndAt      DateTime      @map("new_end_at") @db.Timestamptz
  grantedBy     String        @map("granted_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@map("grace_periods")
}

enum PlatformOrderStatus {
  pending_approval // discount above the creator's limit; a Super Admin must approve
  awaiting_payment
  paid
  cancelled

  @@map("platform_order_status")
}

enum PlatformPaymentMethod {
  bank_transfer
  upi
  cheque
  cash
  razorpay

  @@map("platform_payment_method")
}

/// Platform table: what AHEAD sells to a client (plan + add-ons + users), priced and taxed once.
model PlatformOrder {
  id              String              @id @default(uuid(7)) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  kind            String              @default("fresh") // fresh | renewal | upgrade
  status          PlatformOrderStatus @default(awaiting_payment)
  planId          String              @map("plan_id") @db.Uuid
  cycle           BillingCycle
  items           Json // [{ itemType, itemRef, priceId, quantity, unitPaise, amountPaise, description }]
  listPaise       BigInt              @map("list_paise")
  discountBp      Int                 @default(0) @map("discount_bp") // sales discount, basis points
  couponCode      String?             @map("coupon_code")
  discountPaise   BigInt              @default(0) @map("discount_paise") // sales discount + coupon
  taxablePaise    BigInt              @map("taxable_paise")
  cgstPaise       BigInt              @default(0) @map("cgst_paise")
  sgstPaise       BigInt              @default(0) @map("sgst_paise")
  igstPaise       BigInt              @default(0) @map("igst_paise")
  totalPaise      BigInt              @map("total_paise")
  billTo          Json                @map("bill_to") // name, gstin, stateCode, address at order time
  createdBy       String              @map("created_by") @db.Uuid
  approvedBy      String?             @map("approved_by") @db.Uuid
  approvedAt      DateTime?           @map("approved_at") @db.Timestamptz
  cancelledReason String?             @map("cancelled_reason")
  expiresAt       DateTime            @map("expires_at") @db.Timestamptz
  paidAt          DateTime?           @map("paid_at") @db.Timestamptz
  paymentLinkId   String?             @unique @map("payment_link_id")
  paymentLinkUrl  String?             @map("payment_link_url")
  paymentLinkAt   DateTime?           @map("payment_link_at") @db.Timestamptz
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz

  payments PlatformPayment[]
  invoice  PlatformInvoice?

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("platform_orders")
}

/// Platform table: money AHEAD received. Offline payments are recorded by Finance; gateway ones arrive by webhook.
model PlatformPayment {
  id               String                @id @default(uuid(7)) @db.Uuid
  orderId          String                @map("order_id") @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  method           PlatformPaymentMethod
  amountPaise      BigInt                @map("amount_paise")
  reference        String?
  gatewayPaymentId String?               @unique @map("gateway_payment_id")
  receivedAt       DateTime              @map("received_at") @db.Timestamptz
  recordedBy       String?               @map("recorded_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz

  order PlatformOrder @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@map("platform_payments")
}

/// Platform table: AHEAD's GST invoice to a client. Numbered only when paid; never edited.
model PlatformInvoice {
  id           String   @id @default(uuid(7)) @db.Uuid
  number       String   @unique // AHD/26-27/000123
  fy           String
  tenantId     String   @map("tenant_id") @db.Uuid
  orderId      String   @unique @map("order_id") @db.Uuid
  seller       Json // AHEAD billing details at issue time
  billTo       Json     @map("bill_to")
  lines        Json // [{ description, sac, quantity, taxablePaise, cgstPaise, sgstPaise, igstPaise, totalPaise }]
  taxablePaise BigInt   @map("taxable_paise")
  cgstPaise    BigInt   @map("cgst_paise")
  sgstPaise    BigInt   @map("sgst_paise")
  igstPaise    BigInt   @map("igst_paise")
  totalPaise   BigInt   @map("total_paise")
  issuedAt     DateTime @default(now()) @map("issued_at") @db.Timestamptz

  order PlatformOrder @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@map("platform_invoices")
}

/// Platform table: AHEAD's credit note against its own invoice (refunds). Never edited.
model PlatformCreditNote {
  id           String   @id @default(uuid(7)) @db.Uuid
  number       String   @unique // CN/26-27/000001
  fy           String
  tenantId     String   @map("tenant_id") @db.Uuid
  invoiceId    String   @unique @map("invoice_id") @db.Uuid // v1: one full credit note per invoice
  reason       String
  taxablePaise BigInt   @map("taxable_paise")
  cgstPaise    BigInt   @map("cgst_paise")
  sgstPaise    BigInt   @map("sgst_paise")
  igstPaise    BigInt   @map("igst_paise")
  totalPaise   BigInt   @map("total_paise")
  createdBy    String   @map("created_by") @db.Uuid
  issuedAt     DateTime @default(now()) @map("issued_at") @db.Timestamptz

  @@index([tenantId])
  @@map("platform_credit_notes")
}

/// Platform table: every gateway webhook, stored once by its event id (idempotency).
model WebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  gateway     String
  eventId     String    @unique @map("event_id")
  type        String
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  error       String?
  /// Console › System health: a person dealt with the error
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy  String?   @map("resolved_by") @db.Uuid

  @@map("webhook_events")
}

/// Platform table: someone applied on the website to be a vendor or partner (Console › Applications)
model ConsoleApplication {
  id           String    @id @default(uuid(7)) @db.Uuid
  kind         String // vendor | partner
  name         String
  company      String?
  email        String
  mobile       String
  city         String?
  stateCode    String?   @map("state_code") @db.Char(2)
  gstin        String?   @db.VarChar(15)
  message      String?
  status       String    @default("new") // new | approved | rejected
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz
  decisionNote String?   @map("decision_note")
  /// The partner or Console member created on approval
  resultId     String?   @map("result_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, createdAt])
  @@index([email])
  @@map("console_applications")
}

/// Platform table: last run of each scheduled job (Console › System health)
model JobRun {
  name           String    @id
  lastStartedAt  DateTime? @map("last_started_at") @db.Timestamptz
  lastFinishedAt DateTime? @map("last_finished_at") @db.Timestamptz
  lastOkAt       DateTime? @map("last_ok_at") @db.Timestamptz
  lastError      String?   @map("last_error")
  runs           Int       @default(0)
  failures       Int       @default(0)
  /// Held while a run is going; a run that dies leaves it to run out
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  /// What the last run did, e.g. "40 done, 2 failed"
  lastSummary    String?   @map("last_summary")

  @@map("job_runs")
}

/// Platform table: AHEAD's own document number series per financial year.
model PlatformSequence {
  docType String @map("doc_type")
  fy      String
  nextNo  Int    @default(1) @map("next_no")

  @@id([docType, fy])
  @@map("platform_sequences")
}

/// Platform table (no RLS, never visible to tenants): who brought the tenant in.
/// Written once by createTenant() and locked; only a Super Admin may change it, with a reason.
model TenantAcquisition {
  tenantId         String            @id @map("tenant_id") @db.Uuid
  acquiredByType   AcquiredByType    @map("acquired_by_type")
  acquiredByUserId String?           @map("acquired_by_user_id") @db.Uuid
  method           AcquisitionMethod
  referralCode     String?           @map("referral_code")
  couponCode       String?           @map("coupon_code")
  lockedAt         DateTime          @default(now()) @map("locked_at") @db.Timestamptz
  changedBy        String?           @map("changed_by") @db.Uuid
  changeReason     String?           @map("change_reason")
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([acquiredByUserId])
  @@map("tenant_acquisitions")
}

enum AccessLinkKind {
  client_owner
  console_member

  @@map("access_link_kind")
}

/// Console v3: one-time login link (7 days). The person verifies their mobile and sets their own password.
model AccessLink {
  id        String         @id @default(uuid(7)) @db.Uuid
  tokenHash String         @unique(map: "access_links_token_hash_key") @map("token_hash")
  kind      AccessLinkKind
  userId    String         @map("user_id") @db.Uuid
  tenantId  String?        @map("tenant_id") @db.Uuid
  createdBy String?        @map("created_by") @db.Uuid
  expiresAt DateTime       @map("expires_at") @db.Timestamptz
  openedAt  DateTime?      @map("opened_at") @db.Timestamptz
  usedAt    DateTime?      @map("used_at") @db.Timestamptz
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], map: "access_links_user_fkey")
  tenant Tenant? @relation(fields: [tenantId], references: [id], map: "access_links_tenant_fkey")

  @@index([userId], map: "access_links_user_idx")
  @@index([tenantId], map: "access_links_tenant_idx")
  @@map("access_links")
}

/// Platform table (no RLS): prevents repeated trials by the same business.
model TrialRegistry {
  id         String   @id @default(uuid(7)) @db.Uuid
  mobileHash String?  @map("mobile_hash")
  emailHash  String?  @map("email_hash")
  gstin      String?  @db.VarChar(15)
  tenantId   String   @map("tenant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([mobileHash])
  @@index([emailHash])
  @@index([gstin])
  @@map("trial_registry")
}

// ─────────────────────── Roles & permissions ───────────────────────

model Permission {
  key         String           @id // module.resource.action
  moduleKey   String           @map("module_key")
  resource    String
  action      PermissionAction
  description String

  @@map("permissions")
}

model Role {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid // null = predefined
  key             String
  name            String
  description     String?
  layer           RoleLayer
  roleType        RoleType  @map("role_type")
  requiredModules String[]  @default([]) @map("required_modules")
  isSystem        Boolean   @default(false) @map("is_system")
  isPredefined    Boolean   @default(false) @map("is_predefined")
  clonedFrom      String?   @map("cloned_from") @db.Uuid
  templateVersion Int       @default(1) @map("template_version")
  sort            Int       @default(0)
  version         Int       @default(1)
  /// Console roles: permissions edited by an Admin; the seed leaves them alone until reset
  customizedAt    DateTime? @map("customized_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  permissions     RolePermission[]
  fieldAccess     RoleFieldAccess[]
  members         TenantMember[]
  platformMembers PlatformMember[]

  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId        String          @map("role_id") @db.Uuid
  tenantId      String?         @map("tenant_id") @db.Uuid
  permissionKey String          @map("permission_key")
  scope         PermissionScope @default(all)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model RoleFieldAccess {
  id       String      @id @default(uuid(7)) @db.Uuid
  roleId   String      @map("role_id") @db.Uuid
  tenantId String?     @map("tenant_id") @db.Uuid
  entity   String
  field    String
  access   FieldAccess @default(hidden)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, entity, field])
  @@map("role_field_access")
}

model TenantRoleSetting {
  tenantId String  @map("tenant_id") @db.Uuid
  roleId   String  @map("role_id") @db.Uuid
  hidden   Boolean @default(false)

  @@id([tenantId, roleId])
  @@map("tenant_role_settings")
}

// ─────────────────────── Configuration engine ───────────────────────

model IndustryTemplate {
  key         String   @db.VarChar(40)
  version     Int
  name        String
  description String?
  definition  Json
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz

  @@id([key, version])
  @@map("industry_templates")
}

model TenantTerm {
  tenantId String       @map("tenant_id") @db.Uuid
  termKey  String       @map("term_key")
  value    String
  source   RecordSource @default(template)

  @@id([tenantId, termKey])
  @@map("tenant_terms")
}

model FieldDefinition {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  entity         String
  key            String
  label          String
  type           FieldType
  required       Boolean      @default(false)
  options        Json?
  validation     Json?
  relationEntity String?      @map("relation_entity")
  position       Int          @default(0)
  source         RecordSource @default(tenant)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, entity, key])
  @@map("field_definitions")
}

model FormLayout {
  tenantId String @map("tenant_id") @db.Uuid
  entity   String
  layout   Json

  @@id([tenantId, entity])
  @@map("form_layouts")
}

// ───────────────── Plans, subscriptions & entitlements ─────────────────

/// Platform table: values for settings defined in contracts/config.ts. scope = 'platform' for now.
model ConfigValue {
  scope     String
  key       String
  value     Json
  version   Int      @default(1)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([scope, key])
  @@map("config_values")
}

model Module {
  key          String   @id
  name         String
  description  String?
  category     String
  dependsOn    String[] @default([]) @map("depends_on")
  isFreeTier   Boolean  @default(false) @map("is_free_tier")
  isUsageBased Boolean  @default(false) @map("is_usage_based")
  isV1         Boolean  @default(true) @map("is_v1")
  sort         Int      @default(0)

  @@map("modules")
}

model Plan {
  id       String  @id @default(uuid(7)) @db.Uuid
  key      String  @unique
  name     String
  tagline  String?
  limits   Json
  isPublic Boolean @default(true) @map("is_public")
  sort     Int     @default(0)

  modules PlanModule[]

  @@map("plans")
}

model PlanModule {
  planId    String @map("plan_id") @db.Uuid
  moduleKey String @map("module_key")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, moduleKey])
  @@map("plan_modules")
}

model Price {
  id          String        @id @default(uuid(7)) @db.Uuid
  itemType    PriceItemType @map("item_type")
  itemRef     String        @map("item_ref") // plan key / module key / 'user' / pack key
  cycle       BillingCycle
  amountPaise BigInt        @map("amount_paise")
  activeFrom  DateTime      @default(now()) @map("active_from") @db.Timestamptz
  activeTo    DateTime?     @map("active_to") @db.Timestamptz

  @@index([itemType, itemRef, cycle])
  @@map("prices")
}

model Coupon {
  code           String     @id
  type           CouponType
  value          Int
  appliesTo      String     @default("all") @map("applies_to")
  validFrom      DateTime?  @map("valid_from") @db.Timestamptz
  validTo        DateTime?  @map("valid_to") @db.Timestamptz
  maxRedemptions Int?       @map("max_redemptions")
  redeemed       Int        @default(0)
  vendorId       String?    @map("vendor_id") @db.Uuid

  @@map("coupons")
}

/// Console Phase D: a plan being edited; published by an Admin
model PlanDraft {
  planKey   String   @id @map("plan_key")
  data      Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("plan_drafts")
}

/// Console Phase D: a module switched on (beyond the plan) or off for one business
model TenantModuleOverride {
  tenantId  String    @map("tenant_id") @db.Uuid
  moduleKey String    @map("module_key")
  state     String
  until     DateTime? @db.Timestamptz
  reason    String
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@id([tenantId, moduleKey])
  @@map("tenant_module_overrides")
}

model Subscription {
  id                 String       @id @default(uuid(7)) @db.Uuid
  tenantId           String       @unique @map("tenant_id") @db.Uuid
  planId             String       @map("plan_id") @db.Uuid
  status             TenantStatus
  cycle              BillingCycle @default(monthly)
  trialEndsAt        DateTime?    @map("trial_ends_at") @db.Timestamptz
  currentPeriodStart DateTime?    @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime?    @map("current_period_end") @db.Timestamptz
  graceEndsAt        DateTime?    @map("grace_ends_at") @db.Timestamptz
  cancelAtPeriodEnd  Boolean      @default(false) @map("cancel_at_period_end")
  autoRenew          Boolean      @default(true) @map("auto_renew")
  mandateId          String?      @map("mandate_id") @db.Uuid
  purgeAt            DateTime?    @map("purge_at") @db.Timestamptz
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  items            SubscriptionItem[]
  scheduledChanges ScheduledChange[]

  @@index([status, trialEndsAt])
  @@map("subscriptions")
}

model SubscriptionItem {
  id              String    @id @default(uuid(7)) @db.Uuid
  subscriptionId  String    @map("subscription_id") @db.Uuid
  priceId         String    @map("price_id") @db.Uuid
  quantity        Int       @default(1)
  unitAmountPaise BigInt    @map("unit_amount_paise")
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  endsAt          DateTime? @map("ends_at") @db.Timestamptz

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_items")
}

model ScheduledChange {
  id             String    @id @default(uuid(7)) @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  change         Json
  effectiveAt    DateTime  @map("effective_at") @db.Timestamptz
  appliedAt      DateTime? @map("applied_at") @db.Timestamptz

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("scheduled_changes")
}

model TenantEntitlement {
  tenantId    String            @map("tenant_id") @db.Uuid
  moduleKey   String            @map("module_key")
  status      EntitlementStatus
  limits      Json              @default("{}")
  activatedAt DateTime?         @map("activated_at") @db.Timestamptz // first time active ⇒ "ever used"
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([tenantId, moduleKey])
  @@map("tenant_entitlements")
}

model UsageCounter {
  tenantId String @map("tenant_id") @db.Uuid
  metric   String
  period   String // YYYY-MM
  used     BigInt @default(0)

  @@id([tenantId, metric, period])
  @@map("usage_counters")
}

model CreditBalance {
  tenantId  String    @map("tenant_id") @db.Uuid
  type      String // ai | sms | whatsapp
  balance   BigInt    @default(0)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  @@id([tenantId, type])
  @@map("credit_balances")
}

// ─────────────────────── Events, audit, notifications ───────────────────────

model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  type        String
  version     Int       @default(1) @db.SmallInt
  payload     Json
  actor       Json
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  /// Claimed by a relay until then (a crash mid-way frees it)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz
  /// After a failure: not tried again before this
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumer, eventId])
  @@map("processed_events")
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  actorKind String   @map("actor_kind") // user | system | platform
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  requestId String?  @map("request_id")
  at        DateTime @default(now()) @db.Timestamptz

  @@index([tenantId, at(sort: Desc)])
  @@map("audit_log")
}

model NotificationLog {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String?  @map("tenant_id") @db.Uuid
  template String
  channel  String
  dedupKey String?  @unique @map("dedup_key")
  target   String?
  status   String   @default("sent")
  sentAt   DateTime @default(now()) @map("sent_at") @db.Timestamptz

  @@index([tenantId])
  @@map("notification_log")
}

/// In-app notifications (AUT-01)
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ═════════════════════════ Business modules — Phase 1 (free core) ═════════════════════════
// Every table below carries tenant_id and is protected by RLS (migration *_phase1_modules).

enum ItemType {
  product
  service

  @@map("item_type")
}

enum ContactType {
  lead
  customer
  supplier

  @@map("contact_type")
}

enum LeadStatus {
  new
  contacted
  qualified
  lost
  converted

  @@map("lead_status")
}

enum ActivityType {
  note
  call
  meeting
  follow_up
  task
  email

  @@map("activity_type")
}

enum SalesDocKind {
  quotation
  invoice
  credit_note
  opening_balance
  sales_order
  delivery_challan
  debit_note

  @@map("sales_doc_kind")
}

enum SalesDocStatus {
  draft
  sent
  accepted
  declined
  converted
  issued
  partially_paid
  paid
  cancelled
  open
  part_invoiced
  completed

  @@map("sales_doc_status")
}

enum PaymentMethod {
  cash
  upi
  card
  bank
  cheque
  other

  @@map("payment_method")
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled

  @@map("task_status")
}

enum TaskPriority {
  low
  medium
  high
  urgent

  @@map("task_priority")
}

enum AppointmentKind {
  appointment
  event

  @@map("appointment_kind")
}

enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show

  @@map("appointment_status")
}

// ── Product & Service Catalogue (CAT-01, CAT-02) ──

model ItemCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// Inactive: hidden from new choices, kept on old records
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, name])
  @@map("item_categories")
}

model Item {
  id                  String       @id @default(uuid(7)) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  type                ItemType     @default(product)
  name                String
  sku                 String?
  categoryId          String?      @map("category_id") @db.Uuid
  unit                String       @default("pcs")
  pricePaise          BigInt       @default(0) @map("price_paise")
  costPricePaise      BigInt?      @map("cost_price_paise")
  gstRateBp           Int          @default(1800) @map("gst_rate_bp") // 1800 = 18%
  hsnSac              String?      @map("hsn_sac") @db.VarChar(10)
  durationMin         Int?         @map("duration_min")
  skill               String?
  description         String?
  imageUrl            String?      @map("image_url")
  isActive            Boolean      @default(true) @map("is_active")
  /// Inventory counts this item: sales and returns move its stock
  trackStock          Boolean      @default(false) @map("track_stock")
  /// Low-stock alert below this quantity
  reorderLevel        Decimal?     @map("reorder_level") @db.Decimal(18, 3)
  /// none | batch | serial
  tracking            String       @default("none") @db.VarChar(10)
  /// A second unit, e.g. box = 12 pcs: altFactor base units in one altUnit
  altUnit             String?      @map("alt_unit") @db.VarChar(20)
  altFactor           Decimal?     @map("alt_factor") @db.Decimal(18, 3)
  barcode             String?      @db.VarChar(48)
  /// Items made as variants of one product share this name
  variantGroup        String?      @map("variant_group") @db.VarChar(160)
  attributes          Json         @default("{}")
  /// Purchase: who this item is usually bought from (low stock to purchase order)
  preferredSupplierId String?      @map("preferred_supplier_id") @db.Uuid
  custom              Json         @default("{}")
  source              RecordSource @default(tenant)
  createdBy           String?      @map("created_by") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  version             Int          @default(1)

  @@index([tenantId, name])
  @@map("items")
}

// ── CRM (CRM-01..04) ──

model Contact {
  id               String      @id @default(uuid(7)) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  branchId         String?     @map("branch_id") @db.Uuid
  type             ContactType @default(customer)
  name             String
  companyName      String?     @map("company_name")
  phone            String?     @db.VarChar(15)
  email            String?
  gstin            String?     @db.VarChar(15)
  stateCode        String?     @map("state_code") @db.Char(2)
  address          Json?
  /// Customers: where goods are delivered when not the billing address
  shippingAddress  Json?       @map("shipping_address")
  leadStatus       LeadStatus? @map("lead_status")
  leadSource       String?     @map("lead_source")
  ownerId          String?     @map("owner_id") @db.Uuid
  isActive         Boolean     @default(true) @map("is_active")
  notes            String?
  custom           Json        @default("{}")
  /// Created by "Try with sample data"; removed together from Settings › Data
  isSample         Boolean     @default(false) @map("is_sample")
  /// Empty = no limit
  creditLimitPaise BigInt?     @map("credit_limit_paise")
  lastRemindedAt   DateTime?   @map("last_reminded_at") @db.Timestamptz
  /// whatsapp | sms | email
  lastReminderVia  String?     @map("last_reminder_via") @db.VarChar(10)
  priceListId      String?     @map("price_list_id") @db.Uuid
  /// Supplier: days given to pay a bill
  paymentDays      Int?        @map("payment_days")
  createdBy        String?     @map("created_by") @db.Uuid
  convertedAt      DateTime?   @map("converted_at") @db.Timestamptz
  /// Leads: what they want
  subject          String?
  pipelineId       String?     @map("pipeline_id") @db.Uuid
  stageId          String?     @map("stage_id") @db.Uuid
  followUpOn       DateTime?   @map("follow_up_on") @db.Date
  /// Leads: expected value of the sale
  valuePaise       BigInt?     @map("value_paise")
  labels           String[]    @default([])
  lostReason       String?     @map("lost_reason")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  /// Customer portal: last visit, and access turned off for this customer
  portalSeenAt     DateTime?   @map("portal_seen_at") @db.Timestamptz
  portalBlocked    Boolean     @default(false) @map("portal_blocked")
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  version          Int         @default(1)

  @@index([tenantId, type, name])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@map("contacts")
}

/// Rates for a group of customers: a discount on every item, and exact prices for some.
model PriceList {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  discountBp Int      @default(0) @map("discount_bp")
  /// Inactive: hidden from new choices, kept on old records
  isActive  Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  items PriceListItem[]

  @@unique([tenantId, name])
  @@map("price_lists")
}

model PriceListItem {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  priceListId String @map("price_list_id") @db.Uuid
  itemId      String @map("item_id") @db.Uuid
  pricePaise  BigInt @map("price_paise")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, itemId])
  @@index([tenantId, itemId])
  @@map("price_list_items")
}

model Activity {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  contactId   String       @map("contact_id") @db.Uuid
  type        ActivityType
  title       String?
  body        String?
  dueAt       DateTime?    @map("due_at") @db.Timestamptz
  completedAt DateTime?    @map("completed_at") @db.Timestamptz
  assigneeId  String?      @map("assignee_id") @db.Uuid
  dealId      String?      @map("deal_id") @db.Uuid
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, dealId])
  @@index([tenantId, contactId, createdAt(sort: Desc)])
  @@index([tenantId, assigneeId, dueAt])
  @@map("activities")
}

// ── Quotations & GST invoices (SAL-01, BIL-01..04) ──

model TenantSequence {
  tenantId String @map("tenant_id") @db.Uuid
  docType  String @map("doc_type") // invoice | quotation | receipt
  fy       String // e.g. 26-27
  prefix   String
  nextNo   Int    @default(1) @map("next_no")

  @@id([tenantId, docType, fy])
  @@map("tenant_sequences")
}

model SalesDocument {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  branchId      String?        @map("branch_id") @db.Uuid
  kind          SalesDocKind
  status        SalesDocStatus @default(draft)
  number        String?
  fy            String?
  contactId     String?        @map("contact_id") @db.Uuid
  buyer         Json           @default("{}") // snapshot: name, gstin, phone, email, address, stateCode
  seller        Json? // snapshot at issue: name, legalName, gstin, address, stateCode
  placeOfSupply String?        @map("place_of_supply") @db.Char(2)
  issueDate     DateTime       @map("issue_date") @db.Date
  dueDate       DateTime?      @map("due_date") @db.Date
  subtotalPaise BigInt         @default(0) @map("subtotal_paise")
  discountPaise BigInt         @default(0) @map("discount_paise")
  taxablePaise  BigInt         @default(0) @map("taxable_paise")
  cgstPaise     BigInt         @default(0) @map("cgst_paise")
  sgstPaise     BigInt         @default(0) @map("sgst_paise")
  igstPaise     BigInt         @default(0) @map("igst_paise")
  /// Where the goods go when it is not the billing address: name, line1, city, pincode, stateCode
  shipTo        Json?          @map("ship_to")
  /// Warehouse the goods leave from; a return: the one they come back to. Empty = the default warehouse
  locationId    String?        @map("location_id") @db.Uuid
  /// Given back by the GST portals after the JSON upload
  ewayBillNo    String?        @map("eway_bill_no") @db.VarChar(12)
  ewayBillDate  DateTime?      @map("eway_bill_date") @db.Date
  irn           String?        @db.Char(64)
  irnAckNo      String?        @map("irn_ack_no") @db.VarChar(20)
  irnAckDate    DateTime?      @map("irn_ack_date") @db.Date
  /// Added to make the total a whole rupee; part of totalPaise
  roundOffPaise BigInt         @default(0) @map("round_off_paise")
  totalPaise    BigInt         @default(0) @map("total_paise")
  /// Invoice: settled so far, including advances and credit notes. Credit note: value already used or refunded.
  paidPaise     BigInt         @default(0) @map("paid_paise")
  /// Invoice: the part of paidPaise that came from credit notes
  creditedPaise BigInt         @default(0) @map("credited_paise")
  /// Credit note: return (goods came back) or amount (value reduced only). Opening balance: opening
  noteType      String?        @map("note_type")
  /// Credit or debit note: why it was made (damaged, wrong_item, quality, excess, rate_difference, short_billed, other)
  noteReason    String?        @map("note_reason")
  /// Credit note: the invoice number, frozen for printing
  sourceNumber  String?        @map("source_number")
  /// Credit or debit note: the invoice date, frozen for printing (Rule 53(1A))
  sourceDate    DateTime?      @map("source_date") @db.Date
  notes         String?
  terms         String?
  sourceType    String?        @map("source_type") // quotation | appointment | invoice | sales_order
  sourceId      String?        @map("source_id") @db.Uuid
  shareToken    String?        @unique @map("share_token")
  custom        Json           @default("{}")
  createdBy     String?        @map("created_by") @db.Uuid
  issuedAt      DateTime?      @map("issued_at") @db.Timestamptz
  cancelledAt   DateTime?      @map("cancelled_at") @db.Timestamptz
  cancelReason  String?        @map("cancel_reason")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  version       Int            @default(1)

  lines       SalesDocumentLine[]
  payments    Payment[]
  adjustments AdvanceAdjustment[] @relation("AdjustedInvoice")
  creditUses  AdvanceAdjustment[] @relation("AdjustmentCredit")

  @@unique([tenantId, kind, number])
  @@index([tenantId, kind, status, issueDate])
  @@index([tenantId, contactId])
  @@index([tenantId, sourceId])
  @@index([tenantId, locationId])
  @@map("sales_documents")
}

model SalesDocumentLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  itemId         String?  @map("item_id") @db.Uuid
  description    String
  hsnSac         String?  @map("hsn_sac") @db.VarChar(10)
  unit           String   @default("pcs")
  quantity       Decimal  @db.Decimal(18, 3)
  unitPricePaise BigInt   @map("unit_price_paise")
  discountPaise  BigInt   @default(0) @map("discount_paise")
  taxablePaise   BigInt   @map("taxable_paise")
  gstRateBp      Int      @map("gst_rate_bp")
  cgstPaise      BigInt   @default(0) @map("cgst_paise")
  sgstPaise      BigInt   @default(0) @map("sgst_paise")
  igstPaise      BigInt   @default(0) @map("igst_paise")
  totalPaise     BigInt   @map("total_paise")
  position       Int      @default(0)
  /// Given free on top of quantity; carries no price or tax
  freeQuantity   Decimal  @default(0) @map("free_quantity") @db.Decimal(18, 3)
  sourceLineId   String?  @map("source_line_id") @db.Uuid // credit note: the invoice line it credits; invoice: the order line it bills
  /// Batch chosen on the bill; none means earliest expiry first
  batchId        String?  @map("batch_id") @db.Uuid
  serials        String[] @default([])
  /// The batches the stock came from, frozen for printing
  batches        Json?

  document SalesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@index([tenantId, sourceLineId])
  @@map("sales_document_lines")
}

model Payment {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  documentId  String?       @map("document_id") @db.Uuid // empty = advance, not yet tied to an invoice
  contactId   String?       @map("contact_id") @db.Uuid
  number      String
  amountPaise BigInt        @map("amount_paise") // negative on a reversal
  method      PaymentMethod
  reference   String?
  paidOn      DateTime      @map("paid_on") @db.Date
  notes       String?
  reversesId  String?       @unique @map("reverses_id") @db.Uuid
  /// The cash or bank account it went into; empty = by method
  accountId   String?       @map("account_id") @db.Uuid
  /// Taken or paid back at a POS counter during this shift
  posShiftId  String?       @map("pos_shift_id") @db.Uuid
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  document    SalesDocument?      @relation(fields: [documentId], references: [id])
  reverses    Payment?            @relation("PaymentReversal", fields: [reversesId], references: [id])
  reversal    Payment?            @relation("PaymentReversal")
  adjustments AdvanceAdjustment[]

  /// Cheque photo or UPI screenshot
  attachmentUrl String? @map("attachment_url")
  @@index([tenantId, documentId])
  @@index([tenantId, paidOn])
  @@index([tenantId, contactId])
  @@index([posShiftId])
  @@map("payments_received")
}

/// How much of an advance or credit note went against which invoice. Append-only: removing one adds a negative row.
model AdvanceAdjustment {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  paymentId    String?  @map("payment_id") @db.Uuid
  creditNoteId String?  @map("credit_note_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  amountPaise  BigInt   @map("amount_paise")
  reversesId   String?  @unique @map("reverses_id") @db.Uuid
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment    Payment?           @relation(fields: [paymentId], references: [id])
  creditNote SalesDocument?     @relation("AdjustmentCredit", fields: [creditNoteId], references: [id])
  document   SalesDocument      @relation("AdjustedInvoice", fields: [documentId], references: [id])
  reverses   AdvanceAdjustment? @relation("AdjustmentReversal", fields: [reversesId], references: [id])
  reversal   AdvanceAdjustment? @relation("AdjustmentReversal")

  @@index([tenantId, paymentId])
  @@index([tenantId, documentId])
  @@index([tenantId, creditNoteId])
  @@map("advance_adjustments")
}

// ── Expenses (FIN-01) ──

model Expense {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  branchId    String?       @map("branch_id") @db.Uuid
  category    String
  amountPaise BigInt        @map("amount_paise")
  paidOn      DateTime      @map("paid_on") @db.Date
  method      PaymentMethod @default(cash)
  payee       String?
  notes       String?
  receiptUrl  String?       @map("receipt_url")
  number      String?
  /// Paid from this cash or bank account; empty = by method (cash goes to cash, the rest to the default bank)
  accountId   String?       @map("account_id") @db.Uuid
  contactId   String?       @map("contact_id") @db.Uuid
  reference   String?
  /// GST bill: the supplier's bill number and GSTIN, and the split of the amount
  billNo      String?       @map("bill_no")
  vendorGstin String?       @map("vendor_gstin") @db.VarChar(15)
  taxablePaise BigInt?      @map("taxable_paise")
  gstRateBp   Int?          @map("gst_rate_bp")
  gstPaise    BigInt?       @map("gst_paise")
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  version     Int           @default(1)

  @@index([tenantId, paidOn])
  @@map("expenses")
}

// ── Tasks (TSK-01, TSK-02) ──

model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  parentId    String?      @map("parent_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueAt       DateTime?    @map("due_at") @db.Timestamptz
  assigneeId  String?      @map("assignee_id") @db.Uuid
  contactId   String?      @map("contact_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  labels      String[]     @default([])
  startOn     DateTime?    @map("start_on") @db.Date
  estimateMin Int?         @map("estimate_min")
  /// [{ id, text, done }]
  checklist   Json         @default("[]")
  /// Order on the board within a status
  position    Int          @default(0)
  /// none | daily | weekly | monthly: when done, the next one is made
  repeat      String       @default("none") @db.VarChar(10)
  createdBy   String?      @map("created_by") @db.Uuid
  completedAt DateTime?    @map("completed_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  version     Int          @default(1)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, assigneeId])
  @@index([tenantId, parentId])
  @@index([tenantId, projectId])
  @@map("tasks")
}

/// A piece of work with its own tasks, team, dates and budget
model TaskProject {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String
  code            String?   @db.VarChar(12)
  description     String?
  contactId       String?   @map("contact_id") @db.Uuid
  ownerId         String?   @map("owner_id") @db.Uuid
  memberIds       String[]  @default([]) @map("member_ids") @db.Uuid
  /// planning | active | on_hold | completed | cancelled
  status          String    @default("active") @db.VarChar(12)
  startOn         DateTime? @map("start_on") @db.Date
  dueOn           DateTime? @map("due_on") @db.Date
  budgetPaise     BigInt?   @map("budget_paise")
  billable        Boolean   @default(false)
  hourlyRatePaise BigInt?   @map("hourly_rate_paise")
  color           String    @default("blue") @db.VarChar(12)
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  version         Int       @default(1)

  @@unique([tenantId, name])
  @@map("task_projects")
}

/// Time spent, on a task or a project
model TaskTime {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  taskId    String?  @map("task_id") @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  workDate  DateTime @map("work_date") @db.Date
  minutes   Int
  note      String?
  billable  Boolean  @default(false)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, workDate])
  @@index([tenantId, taskId])
  @@map("task_times")
}

/// Someone asks, a named person approves or rejects (spend, discount, purchase, leave, other)
model ApprovalRequest {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  number        String    @db.VarChar(20)
  title         String
  kind          String    @default("other") @db.VarChar(20)
  amountPaise   BigInt?   @map("amount_paise")
  details       String?
  attachmentUrl String?   @map("attachment_url")
  requestedBy   String    @map("requested_by") @db.Uuid
  approverId    String    @map("approver_id") @db.Uuid
  /// pending | approved | rejected | withdrawn
  status        String    @default("pending") @db.VarChar(10)
  needBy        DateTime? @map("need_by") @db.Date
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz
  decisionNote  String?   @map("decision_note")
  taskId        String?   @map("task_id") @db.Uuid
  projectId     String?   @map("project_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  version       Int       @default(1)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("approval_requests")
}

model TaskEvent {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  taskId   String   @map("task_id") @db.Uuid
  actorId  String?  @map("actor_id") @db.Uuid
  type     String // created | status | assigned | comment | edited
  body     String?
  data     Json?
  at       DateTime @default(now()) @db.Timestamptz

  @@index([tenantId, taskId, at])
  @@map("task_events")
}

// ── Calendar & bookings (BKG-01, BKG-02, BKG-08) ──

model Appointment {
  id        String            @id @default(uuid(7)) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  branchId  String?           @map("branch_id") @db.Uuid
  kind      AppointmentKind   @default(appointment)
  title     String
  contactId String?           @map("contact_id") @db.Uuid
  itemId    String?           @map("item_id") @db.Uuid
  staffId   String?           @map("staff_id") @db.Uuid
  startAt   DateTime          @map("start_at") @db.Timestamptz
  endAt     DateTime          @map("end_at") @db.Timestamptz
  status    AppointmentStatus @default(scheduled)
  notes     String?
  invoiceId String?           @map("invoice_id") @db.Uuid
  resourceId   String?        @map("resource_id") @db.Uuid
  /// walk_in | phone | whatsapp | online
  source       String         @default("walk_in") @db.VarChar(12)
  /// Online bookings by someone not yet a customer
  guestName    String?        @map("guest_name")
  guestPhone   String?        @map("guest_phone") @db.VarChar(15)
  pricePaise   BigInt?        @map("price_paise")
  cancelReason String?        @map("cancel_reason")
  confirmedAt  DateTime?      @map("confirmed_at") @db.Timestamptz
  checkedInAt  DateTime?      @map("checked_in_at") @db.Timestamptz
  remindedAt   DateTime?      @map("reminded_at") @db.Timestamptz
  createdBy String?           @map("created_by") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  version   Int               @default(1)
  attachmentUrl String? @map("attachment_url")

  @@index([tenantId, startAt])
  @@index([tenantId, staffId, startAt])
  @@map("appointments")
}

/// How a service item is booked: length, gap after, who can do it, room needed, online or not
model BookingService {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  durationMin  Int      @default(30) @map("duration_min")
  bufferMin    Int      @default(0) @map("buffer_min")
  color        String   @default("blue") @db.VarChar(12)
  /// Empty = anyone can do it
  staffIds     String[] @default([]) @map("staff_ids") @db.Uuid
  /// room | chair | equipment: a free one of this kind is needed
  resourceKind String?  @map("resource_kind") @db.VarChar(12)
  online       Boolean  @default(true)
  isActive     Boolean  @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  version      Int      @default(1)

  @@unique([tenantId, itemId])
  @@map("booking_services")
}

/// A room, chair or machine an appointment uses
model BookingResource {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  kind      String   @default("room") @db.VarChar(12)
  capacity  Int      @default(1)
  color     String   @default("slate") @db.VarChar(12)
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  version   Int      @default(1)

  @@unique([tenantId, name])
  @@map("booking_resources")
}

/// Working hours: weekday (0 = Sunday) and minutes from midnight
model StaffHours {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  weekday  Int    @db.SmallInt
  startMin Int    @map("start_min")
  endMin   Int    @map("end_min")

  @@index([tenantId, userId])
  @@map("staff_hours")
}

model StaffTimeOff {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fromAt    DateTime @map("from_at") @db.Timestamptz
  toAt      DateTime @map("to_at") @db.Timestamptz
  reason    String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, fromAt])
  @@map("staff_time_off")
}

/// The online booking page: on or off, its link, and how slots are offered
model BookingSettings {
  tenantId     String   @id @map("tenant_id") @db.Uuid
  enabled      Boolean  @default(false)
  slug         String   @unique @db.VarChar(40)
  title        String
  intro        String?
  slotStepMin  Int      @default(30) @map("slot_step_min")
  leadMin      Int      @default(60) @map("lead_min")
  maxDaysAhead Int      @default(30) @map("max_days_ahead")
  autoConfirm  Boolean  @default(false) @map("auto_confirm")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("booking_settings")
}

// ── Phase 2: account security (platform tables) ──

model UserMfa {
  userId         String    @id @map("user_id") @db.Uuid
  secretEnc      String    @map("secret_enc")
  enabledAt      DateTime? @map("enabled_at") @db.Timestamptz
  /// [{ hash, usedAt }] — one-time recovery codes
  backupCodes    Json      @default("[]") @map("backup_codes")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

model UserTrustedDevice {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_trusted_devices")
}

model UserPasswordHistory {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_password_history")
}

model SignInEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  /// Masked email/mobile when no account matched
  identifier String?
  /// success | wrong_password | locked | mfa_challenge | mfa_failed | blocked_ip | expired_password
  outcome    String
  method     String?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("sign_in_events")
}

// ── Phase 4: Console sales workspace (platform tables) ──

model ConsoleProspect {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  businessName String   @map("business_name")
  industryKey  String?  @map("industry_key")
  city         String?
  mobile       String?  @db.VarChar(15)
  email        String?
  source       String?
  /// new | contacted | demo | trial | won | lost
  stage        String   @default("new")
  lostReason   String?  @map("lost_reason")
  ownerUserId  String   @map("owner_user_id") @db.Uuid
  /// The business once it signs up (self or from the Console)
  tenantId     String?  @map("tenant_id") @db.Uuid
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  followups ConsoleFollowup[]
  notes     ConsoleNote[]

  @@index([ownerUserId, stage], map: "console_prospects_owner_idx")
  @@index([mobile], map: "console_prospects_mobile_idx")
  @@index([tenantId], map: "console_prospects_tenant_idx")
  @@map("console_prospects")
}

model ConsoleFollowup {
  id          String    @id @default(uuid(7)) @db.Uuid
  prospectId  String?   @map("prospect_id") @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  title       String
  dueAt       DateTime  @map("due_at") @db.Timestamptz
  ownerUserId String    @map("owner_user_id") @db.Uuid
  doneAt      DateTime? @map("done_at") @db.Timestamptz
  autoKey     String?   @unique(map: "console_followups_auto_key") @map("auto_key")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  prospect ConsoleProspect? @relation(fields: [prospectId], references: [id], onDelete: Cascade, map: "console_followups_prospect_fkey")

  @@index([ownerUserId, doneAt, dueAt], map: "console_followups_owner_idx")
  @@index([tenantId], map: "console_followups_tenant_idx")
  @@map("console_followups")
}

model ConsoleNote {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  prospectId    String?  @map("prospect_id") @db.Uuid
  body          String
  privateToTeam Boolean  @default(false) @map("private_to_team")
  authorId      String   @map("author_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  prospect ConsoleProspect? @relation(fields: [prospectId], references: [id], onDelete: Cascade, map: "console_notes_prospect_fkey")

  @@index([tenantId, createdAt(sort: Desc)], map: "console_notes_tenant_idx")
  @@map("console_notes")
}

/// A godown, store or van where stock is kept
model StockLocation {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  address   String?
  city      String?
  zipCode   String?  @map("zip_code") @db.VarChar(10)
  /// GST state of the warehouse (dispatch-from on e-way bills)
  stateCode String?  @map("state_code") @db.VarChar(2)
  contactPerson String? @map("contact_person")
  phone     String?  @db.VarChar(20)
  email     String?
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, name])
  @@map("stock_locations")
}

/// One opening, stock in, adjustment, transfer or count, with its lines as typed
model StockEntry {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// opening | stock_in | adjustment | transfer | count
  kind         String    @db.VarChar(20)
  locationId   String    @map("location_id") @db.Uuid
  toLocationId String?   @map("to_location_id") @db.Uuid
  entryDate    DateTime  @map("entry_date") @db.Date
  party        String?
  reference    String?
  /// Adjustment: damage | loss | found | sample | other
  reason       String?   @db.VarChar(20)
  note         String?
  lines        Json      @default("[]")
  valuePaise   BigInt    @default(0) @map("value_paise")
  /// posted | in_transit | received
  status       String    @default("posted") @db.VarChar(12)
  receivedAt   DateTime? @map("received_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  /// Photo proof of damage or loss
  attachmentUrl String? @map("attachment_url")
  @@index([tenantId, entryDate])
  @@map("stock_entries")
}

/// The stock ledger: append-only. Positive quantity comes in, negative goes out.
model StockMove {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  locationId   String   @map("location_id") @db.Uuid
  moveDate     DateTime @map("move_date") @db.Date
  /// opening | stock_in | sale | sale_return | adjustment | transfer_in | transfer_out | count
  kind         String   @db.VarChar(20)
  quantity     Decimal  @db.Decimal(18, 3)
  ratePaise    BigInt   @map("rate_paise")
  valuePaise   BigInt   @map("value_paise")
  /// Stock at this location after the move
  balanceQty   Decimal  @map("balance_qty") @db.Decimal(18, 3)
  /// stock_entry | invoice | delivery_challan | credit_note
  sourceType   String   @map("source_type") @db.VarChar(20)
  sourceId     String   @map("source_id") @db.Uuid
  sourceLineId String?  @map("source_line_id") @db.Uuid
  reversesId   String?  @unique @map("reverses_id") @db.Uuid
  batchId      String?  @map("batch_id") @db.Uuid
  serials      String[] @default([])
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, itemId, locationId, createdAt])
  @@index([tenantId, sourceId])
  @@map("stock_moves")
}

/// Running stock per item and godown, kept with the ledger in one transaction
model StockBalance {
  tenantId      String   @map("tenant_id") @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  locationId    String   @map("location_id") @db.Uuid
  quantity      Decimal  @default(0) @db.Decimal(18, 3)
  valuePaise    BigInt   @default(0) @map("value_paise")
  lastRatePaise BigInt   @default(0) @map("last_rate_paise")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@id([itemId, locationId])
  @@index([tenantId])
  @@map("stock_balances")
}

model StockBatch {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  itemId     String    @map("item_id") @db.Uuid
  number     String    @db.VarChar(40)
  mfgDate    DateTime? @map("mfg_date") @db.Date
  expiryDate DateTime? @map("expiry_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([itemId, number])
  @@index([tenantId, expiryDate])
  @@map("stock_batches")
}

model StockBatchBalance {
  tenantId   String  @map("tenant_id") @db.Uuid
  batchId    String  @map("batch_id") @db.Uuid
  locationId String  @map("location_id") @db.Uuid
  quantity   Decimal @default(0) @db.Decimal(18, 3)

  @@id([batchId, locationId])
  @@index([tenantId])
  @@map("stock_batch_balances")
}

/// One unit of a serial-tracked item
model StockSerial {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  serial     String   @db.VarChar(40)
  /// in_stock | sold | transit | gone
  status     String   @db.VarChar(12)
  locationId String?  @map("location_id") @db.Uuid
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([itemId, serial])
  @@index([tenantId, serial])
  @@map("stock_serials")
}

/// What is left of one receipt: FIFO cost and stock ageing
model StockLayer {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  locationId   String   @map("location_id") @db.Uuid
  receivedOn   DateTime @map("received_on") @db.Date
  qtyRemaining Decimal  @map("qty_remaining") @db.Decimal(18, 3)
  ratePaise    BigInt   @map("rate_paise")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([itemId, locationId, receivedOn])
  @@index([tenantId])
  @@map("stock_layers")
}

/// Purchase order, goods receipt (GRN), purchase bill or purchase return
model PurchaseDocument {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  /// purchase_order | goods_receipt | purchase_bill | purchase_return
  kind          String    @db.VarChar(16)
  /// PO: open | part_received | received | cancelled. GRN: received | billed | cancelled.
  /// Bill: draft | unpaid | part_paid | paid | cancelled. Return: draft | approved | issued (shown as Completed) | cancelled.
  status        String    @db.VarChar(16)
  /// Why goods went back, on a purchase return
  returnReason  String?   @map("return_reason") @db.VarChar(40)
  number        String
  fy            String
  contactId     String    @map("contact_id") @db.Uuid
  supplier      Json      @default("{}")
  supplierRef   String?   @map("supplier_ref") @db.VarChar(40)
  supplierDate  DateTime? @map("supplier_date") @db.Date
  issueDate     DateTime  @map("issue_date") @db.Date
  dueDate       DateTime? @map("due_date") @db.Date
  placeOfSupply String?   @map("place_of_supply") @db.Char(2)
  reverseCharge Boolean   @default(false) @map("reverse_charge")
  locationId    String?   @map("location_id") @db.Uuid
  subtotalPaise BigInt    @default(0) @map("subtotal_paise")
  discountPaise BigInt    @default(0) @map("discount_paise")
  taxablePaise  BigInt    @default(0) @map("taxable_paise")
  cgstPaise     BigInt    @default(0) @map("cgst_paise")
  sgstPaise     BigInt    @default(0) @map("sgst_paise")
  igstPaise     BigInt    @default(0) @map("igst_paise")
  chargesPaise  BigInt    @default(0) @map("charges_paise")
  chargesGstBp  Int       @default(0) @map("charges_gst_bp")
  roundOffPaise BigInt    @default(0) @map("round_off_paise")
  totalPaise    BigInt    @default(0) @map("total_paise")
  paidPaise     BigInt    @default(0) @map("paid_paise")
  returnedPaise BigInt    @default(0) @map("returned_paise")
  sourceType    String?   @map("source_type") @db.VarChar(16)
  sourceId      String?   @map("source_id") @db.Uuid
  sourceNumber  String?   @map("source_number")
  notes         String?
  cancelReason  String?   @map("cancel_reason")
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  version       Int       @default(1)

  lines PurchaseDocumentLine[]

  /// The supplier own bill: needed to claim GST input credit (CGST Act s.16(2)(a))
  attachmentUrl String? @map("attachment_url")
  @@unique([tenantId, kind, number])
  @@index([tenantId, kind, status, issueDate])
  @@index([tenantId, contactId])
  @@index([tenantId, sourceId])
  @@map("purchase_documents")
}

model PurchaseDocumentLine {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  itemId         String?   @map("item_id") @db.Uuid
  description    String
  hsnSac         String?   @map("hsn_sac") @db.VarChar(10)
  unit           String    @default("pcs")
  quantity       Decimal   @db.Decimal(18, 3)
  unitPricePaise BigInt    @map("unit_price_paise")
  discountPaise  BigInt    @default(0) @map("discount_paise")
  taxablePaise   BigInt    @map("taxable_paise")
  gstRateBp      Int       @map("gst_rate_bp")
  cgstPaise      BigInt    @default(0) @map("cgst_paise")
  sgstPaise      BigInt    @default(0) @map("sgst_paise")
  igstPaise      BigInt    @default(0) @map("igst_paise")
  totalPaise     BigInt    @map("total_paise")
  landedPaise    BigInt    @default(0) @map("landed_paise")
  position       Int       @default(0)
  sourceLineId   String?   @map("source_line_id") @db.Uuid
  batchNo        String?   @map("batch_no") @db.VarChar(40)
  mfgDate        DateTime? @map("mfg_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  serials        String[]  @default([])

  document PurchaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@index([tenantId, sourceLineId])
  @@map("purchase_document_lines")
}

/// Money paid to a supplier against a purchase bill; corrected by an opposite row, never edited
model SupplierPayment {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  contactId   String   @map("contact_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  number      String
  amountPaise BigInt   @map("amount_paise")
  method      String   @db.VarChar(10)
  reference   String?
  paidOn      DateTime @map("paid_on") @db.Date
  reversesId  String?  @unique @map("reverses_id") @db.Uuid
  /// The cash or bank account it was paid from; empty = by method
  accountId   String?  @map("account_id") @db.Uuid
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  attachmentUrl String? @map("attachment_url")

  @@index([tenantId, contactId])
  @@index([tenantId, documentId])
  @@map("supplier_payments")
}

// ── CRM pipelines and deals ──

/// A sales pipeline: its own lead stages and deal stages (e.g. "Retail", "Projects")
model CrmPipeline {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("crm_pipelines")
}

/// A step a lead or deal moves through; kind = lead | deal
model CrmStage {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  pipelineId  String @map("pipeline_id") @db.Uuid
  kind        String @db.VarChar(10)
  name        String
  color       String @default("blue") @db.VarChar(10)
  position    Int    @default(0)
  /// Deals: chance of winning at this stage, in percent
  probability Int?

  @@index([tenantId, pipelineId, kind])
  @@map("crm_stages")
}

/// Lists the business keeps: kind = source | label | lost_reason
model CrmOption {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  kind     String  @db.VarChar(12)
  name     String
  color    String? @db.VarChar(10)
  position Int     @default(0)

  @@unique([tenantId, kind, name])
  @@map("crm_options")
}

/// A sale being worked on with a customer or lead; status = open | won | lost
model Deal {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  title           String
  contactId       String    @map("contact_id") @db.Uuid
  leadId          String?   @map("lead_id") @db.Uuid
  pipelineId      String    @map("pipeline_id") @db.Uuid
  stageId         String    @map("stage_id") @db.Uuid
  valuePaise      BigInt    @default(0) @map("value_paise")
  status          String    @default("open") @db.VarChar(6)
  lostReason      String?   @map("lost_reason")
  expectedCloseOn DateTime? @map("expected_close_on") @db.Date
  source          String?
  labels          String[]  @default([])
  notes           String?
  ownerId         String?   @map("owner_id") @db.Uuid
  createdBy       String?   @map("created_by") @db.Uuid
  closedAt        DateTime? @map("closed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  version         Int       @default(1)

  @@index([tenantId, pipelineId, status])
  @@index([tenantId, contactId])
  @@map("deals")
}

/// Items a lead or deal is interested in
model CrmProduct {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  contactId  String? @map("contact_id") @db.Uuid
  dealId     String? @map("deal_id") @db.Uuid
  itemId     String  @map("item_id") @db.Uuid
  quantity   Decimal @default(1) @db.Decimal(14, 3)
  pricePaise BigInt  @default(0) @map("price_paise")

  @@index([tenantId, contactId])
  @@index([tenantId, dealId])
  @@map("crm_products")
}

// ── Finance: cash and bank accounts, other income, transfers ──

/// Where money sits: kind = cash | bank | wallet | card
model FinAccount {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  kind         String    @db.VarChar(10)
  bankName     String?   @map("bank_name")
  accountNo    String?   @map("account_no") @db.VarChar(30)
  ifsc         String?   @db.VarChar(11)
  upiId        String?   @map("upi_id")
  openingPaise BigInt    @default(0) @map("opening_paise")
  openingDate  DateTime? @map("opening_date") @db.Date
  /// The account non-cash money goes through when none is chosen
  isDefault    Boolean   @default(false) @map("is_default")
  isActive     Boolean   @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  version      Int       @default(1)

  @@index([tenantId])
  @@map("fin_accounts")
}

/// Expense and income heads the business keeps; kind = expense | income
model FinCategory {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  kind     String @db.VarChar(8)
  name     String
  position Int    @default(0)
  /// Expense heads only: the most to spend in a month
  budgetPaise BigInt? @map("budget_paise")
  /// Inactive: hidden from new choices, kept on old records
  isActive  Boolean  @default(true) @map("is_active")

  @@unique([tenantId, kind, name])
  @@map("fin_categories")
}

/// Money in that is not a customer payment: interest, commission, rent received, scrap sale
model Income {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  number      String
  receivedOn  DateTime @map("received_on") @db.Date
  category    String
  accountId   String   @map("account_id") @db.Uuid
  amountPaise BigInt   @map("amount_paise")
  payer       String?
  contactId   String?  @map("contact_id") @db.Uuid
  reference   String?
  notes       String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  version     Int      @default(1)
  attachmentUrl String? @map("attachment_url")

  @@index([tenantId, receivedOn])
  @@map("incomes")
}

/// Money moved between two of the business's own accounts (cash deposited, cash withdrawn)
model FinTransfer {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  number        String
  transferOn    DateTime @map("transfer_on") @db.Date
  fromAccountId String   @map("from_account_id") @db.Uuid
  toAccountId   String   @map("to_account_id") @db.Uuid
  amountPaise   BigInt   @map("amount_paise")
  chargesPaise  BigInt   @default(0) @map("charges_paise")
  reference     String?
  notes         String?
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, transferOn])
  @@map("fin_transfers")
}

/// A ledger the business adds itself: a loan, capital, a fixed asset, a deposit
model FinLedger {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  /// asset | liability | equity | income | expense
  group       String   @db.VarChar(10)
  code        String?  @db.VarChar(10)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, name])
  @@map("fin_ledgers")
}

/// A journal entry: debits equal credits, for what no bill or payment records
model Journal {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  number     String
  journalOn  DateTime      @map("journal_on") @db.Date
  narration  String
  reference  String?
  totalPaise BigInt        @map("total_paise")
  version    Int           @default(1)
  createdBy  String?       @map("created_by") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  lines      JournalLine[]

  @@index([tenantId, journalOn])
  @@map("journals")
}

model JournalLine {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  journalId   String  @map("journal_id") @db.Uuid
  position    Int     @default(0)
  /// cash:<account id> | input_gst | output_gst | capital | opening | exp:<category> | inc:<category> | led:<ledger id>
  ledgerKey   String  @map("ledger_key") @db.VarChar(80)
  debitPaise  BigInt  @default(0) @map("debit_paise")
  creditPaise BigInt  @default(0) @map("credit_paise")
  description String?
  journal     Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([tenantId, ledgerKey])
  @@index([journalId])
  @@map("journal_lines")
}

/// An expense that repeats (rent, salary): recorded with one click when due
model RecurringExpense {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  /// month | quarter | year | week
  every         String    @db.VarChar(10)
  nextOn        DateTime  @map("next_on") @db.Date
  endsOn        DateTime? @map("ends_on") @db.Date
  /// The expense form without its date
  template      Json
  isActive      Boolean   @default(true) @map("is_active")
  lastExpenseId String?   @map("last_expense_id") @db.Uuid
  version       Int       @default(1)
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, nextOn])
  @@map("recurring_expenses")
}

/// A passbook entry ticked off against the bank statement
model FinCleared {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  entryId   String   @map("entry_id") @db.VarChar(80)
  clearedOn DateTime @map("cleared_on") @db.Date
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, entryId])
  @@map("fin_cleared")
}

// ── HR & Payroll ──

/// HR rules for a business: working days, payroll rules (PF, ESI, PT), lists (award types and the like)
model HrSettings {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("hr_settings")
}

model HrDepartment {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  branchId  String?  @map("branch_id") @db.Uuid
  headId    String?  @map("head_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, name])
  @@map("hr_departments")
}

model HrDesignation {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  departmentId String?  @map("department_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, name])
  @@map("hr_designations")
}

model HrShift {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  startsAt     String   @map("starts_at") @db.VarChar(5)
  endsAt       String   @map("ends_at") @db.VarChar(5)
  breakMinutes Int      @default(0) @map("break_minutes")
  graceMinutes Int      @default(0) @map("grace_minutes")
  isNight      Boolean  @default(false) @map("is_night")
  isDefault    Boolean  @default(false) @map("is_default")
