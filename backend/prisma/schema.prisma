  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// Knowledge base: help articles and saved replies
model KbArticle {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  title     String
  body      String
  category  String?  @db.VarChar(30)
  tags      String[] @default([])
  kind      String   @default("article") @db.VarChar(8)
  published Boolean  @default(true)
  uses      Int      @default(0)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version   Int      @default(1)

  @@index([tenantId, kind])
  @@map("kb_articles")
}

/// Customer portal setup: the link, the title and which parts customers see
model PortalSettings {
  tenantId        String   @id @map("tenant_id") @db.Uuid
  enabled         Boolean  @default(false)
  slug            String?  @unique @db.VarChar(40)
  title           String   @default("Your account")
  intro           String?
  showBills       Boolean  @default(true) @map("show_bills")
  showQuotes      Boolean  @default(true) @map("show_quotes")
  allowQuoteReply Boolean  @default(true) @map("allow_quote_reply")
  showStatement   Boolean  @default(true) @map("show_statement")
  showRequests    Boolean  @default(true) @map("show_requests")
  showBookings    Boolean  @default(true) @map("show_bookings")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("portal_settings")
}

// ── POS: counter billing (BIL-08) ──

/// A billing counter: where its sales are billed from (branch, warehouse) and paid into
model PosCounter {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String   @db.VarChar(60)
  branchId      String?  @map("branch_id") @db.Uuid
  /// Warehouse the goods leave from; empty = the default warehouse
  locationId    String?  @map("location_id") @db.Uuid
  /// Cash goes here; empty = the first cash account
  cashAccountId String?  @map("cash_account_id") @db.Uuid
  /// UPI and card go here; empty = the default bank account
  bankAccountId String?  @map("bank_account_id") @db.Uuid
  /// 80mm | 58mm | a4
  paper         String   @default("80mm") @db.VarChar(4)
  receiptNote   String?  @map("receipt_note")
  /// Most discount a cashier may give on a bill without approval; empty = no limit
  maxDiscountBp Int?     @map("max_discount_bp")
  /// A known customer may pay part now and owe the rest
  allowCredit   Boolean  @default(true) @map("allow_credit")
  /// Every bill needs a customer name and phone
  needCustomer  Boolean  @default(false) @map("need_customer")
  isActive      Boolean  @default(true) @map("is_active")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version       Int      @default(1)

  shifts PosShift[]
  held   PosHeldBill[]

  @@unique([tenantId, name])
  @@map("pos_counters")
}

/// One person's time at a counter, from the opening cash to the cash counted at close
model PosShift {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  counterId         String    @map("counter_id") @db.Uuid
  number            String    @db.VarChar(20)
  /// open | closed
  status            String    @default("open") @db.VarChar(8)
  openedBy          String    @map("opened_by") @db.Uuid
  openedAt          DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  openingCashPaise  BigInt    @default(0) @map("opening_cash_paise")
  closedBy          String?   @map("closed_by") @db.Uuid
  closedAt          DateTime? @map("closed_at") @db.Timestamptz
  expectedCashPaise BigInt?   @map("expected_cash_paise")
  countedCashPaise  BigInt?   @map("counted_cash_paise")
  /// counted minus expected: negative = short, positive = extra
  differencePaise   BigInt?   @map("difference_paise")
  /// { "500": 4, "100": 12, ... } notes and coins counted
  denominations     Json?
  closingNote       String?   @map("closing_note")
  /// Cash sent to the bank at close (a transfer in Finance)
  depositPaise      BigInt    @default(0) @map("deposit_paise")
  depositTransferId String?   @map("deposit_transfer_id") @db.Uuid
  version           Int       @default(1)

  counter PosCounter    @relation(fields: [counterId], references: [id])
  moves   PosCashMove[]

  @@unique([tenantId, number])
  @@index([tenantId, openedAt])
  @@map("pos_shifts")
}

/// Cash put into or taken out of the drawer during a shift (not a sale)
model PosCashMove {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  shiftId     String   @map("shift_id") @db.Uuid
  /// in | out
  kind        String   @db.VarChar(4)
  amountPaise BigInt   @map("amount_paise")
  /// in: float | change | other; out: expense | owner | change | other
  reason      String   @db.VarChar(16)
  note        String?
  /// Paid out for a shop expense: the expense made in Finance
  expenseId   String?  @map("expense_id") @db.Uuid
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  shift PosShift @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@map("pos_cash_moves")
}

/// A bill parked at the counter to serve the next customer, picked up again later
model PosHeldBill {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  counterId  String   @map("counter_id") @db.Uuid
  label      String   @db.VarChar(60)
  cart       Json
  totalPaise BigInt   @default(0) @map("total_paise")
  lines      Int      @default(0)
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  counter PosCounter @relation(fields: [counterId], references: [id], onDelete: Cascade)

  @@index([counterId])
  @@map("pos_held_bills")
}

/// An uploaded photo or document; the bytes are in file storage (kernel/storage.ts)
model StoredFile {
  id         String   @id @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  entityType String?  @map("entity_type") @db.VarChar(32)
  entityId   String?  @map("entity_id") @db.Uuid
  field      String   @default("attachments") @db.VarChar(32)
  name       String   @db.VarChar(200)
  mime       String   @db.VarChar(100)
  sizeBytes  Int      @map("size_bytes")
  sha256     String   @db.Char(64)
  storageKey String   @map("storage_key") @db.VarChar(300)
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, entityType, entityId])
  @@map("files")
}
