// AHEAD SOFTWARE — Platform core schema (LLD v1 §3–§9)
// Conventions: snake_case tables/columns, UUID v7 ids, money as bigint paise,
// timestamptz everywhere. Tenant tables carry tenant_id and are protected by RLS
// (see migrations/*_rls/migration.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  active
  locked
  disabled

  @@map("user_status")
}

enum OtpChannel {
  sms
  whatsapp
  email

  @@map("otp_channel")
}

enum OtpPurpose {
  signup
  login
  reset
  vendor_signup
  mfa
  invite
  email_change
  mobile_change
  close_account

  @@map("otp_purpose")
}

enum TenantStatus {
  incomplete // created by sales/vendor, waiting for the first payment (design v2)
  trialing
  active
  past_due
  free
  closed
  purged

  @@map("tenant_status")
}

enum TenantSource {
  direct
  vendor
  sales
  partner

  @@map("tenant_source")
}

/// How the tenant started: self-signup trial, or created by sales/vendor and paid up front
enum OnboardingType {
  trial
  direct_paid

  @@map("onboarding_type")
}

enum AcquiredByType {
  self
  vendor
  sales_user
  partner_user

  @@map("acquired_by_type")
}

enum AcquisitionMethod {
  signup
  referral_link
  referral_code
  manual

  @@map("acquisition_method")
}

/// Which side of the app a session works in (design v2: Console + Business ERP)
enum Workspace {
  tenant
  console

  @@map("workspace")
}

enum BillingOwner {
  self
  partner

  @@map("billing_owner")
}

enum MemberStatus {
  invited
  active
  deactivated

  @@map("member_status")
}

enum PermissionAction {
  view
  create
  edit
  delete
  approve
  export

  @@map("permission_action")
}

enum RoleLayer {
  platform
  partner
  vendor
  tenant

  @@map("role_layer")
}

enum RoleType {
  admin
  user
  salesperson
  counter
  employee

  @@map("role_type")
}

enum PermissionScope {
  own
  team
  branch
  all

  @@map("permission_scope")
}

enum FieldAccess {
  hidden
  read
  write

  @@map("field_access")
}

enum FieldType {
  text
  number
  date
  dropdown
  multi_select
  checkbox
  attachment
  relation

  @@map("field_type")
}

enum RecordSource {
  template
  tenant
  sample

  @@map("record_source")
}

enum PriceItemType {
  plan
  addon_module
  extra_user
  credit_pack

  @@map("price_item_type")
}

enum BillingCycle {
  monthly
  yearly
  one_time

  @@map("billing_cycle")
}

enum CouponType {
  percent
  flat

  @@map("coupon_type")
}

enum EntitlementStatus {
  active
  read_only
  inactive

  @@map("entitlement_status")
}

// ─────────────────────── Identity & tenancy ───────────────────────

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  name             String
  email            String     @unique // stored lower-cased
  mobile           String     @unique @db.VarChar(15) // E.164
  passwordHash     String?    @map("password_hash")
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz
  mobileVerifiedAt DateTime?  @map("mobile_verified_at") @db.Timestamptz
  mfaEnabled       Boolean    @default(false) @map("mfa_enabled")
  status           UserStatus @default(active)
  failedLogins     Int        @default(0) @map("failed_logins")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz
  lastTenantId     String?    @map("last_tenant_id") @db.Uuid
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz
  /// Personal theme, font, density, start page, date format (contracts/account.ts)
  preferences      Json       @default("{}")
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  sessions       UserSession[]
  mfa            UserMfa?
  trustedDevices UserTrustedDevice[]
  passwordHistory UserPasswordHistory[]
  memberships    TenantMember[]
  platformMember PlatformMember?

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid // tenant the session is currently working in
  workspace        Workspace @default(tenant) // console = AHEAD team workspace (tenantId is null)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("user_sessions")
}

model OtpCode {
  id         String     @id @default(uuid(7)) @db.Uuid
  target     String
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0) @db.SmallInt
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([target, purpose, createdAt(sort: Desc)])
  @@map("otp_codes")
}

model Tenant {
  id               String         @id @default(uuid(7)) @db.Uuid
  name             String
  legalName        String?        @map("legal_name")
  industryKey      String         @map("industry_key")
  templateVersion  Int            @map("template_version")
  status           TenantStatus   @default(trialing)
  source           TenantSource   @default(direct)
  onboardingType   OnboardingType @default(trial) @map("onboarding_type")
  isInternal       Boolean        @default(false) @map("is_internal")
  partnerId        String?        @map("partner_id") @db.Uuid
  billingOwner     BillingOwner   @default(self) @map("billing_owner")
  gstin            String?        @db.VarChar(15)
  billingStateCode String?        @map("billing_state_code") @db.Char(2)
  address          Json?
  logoUrl          String?        @map("logo_url")
  timezone         String         @default("Asia/Kolkata")
  fyStartMonth     Int            @default(4) @map("fy_start_month") @db.SmallInt
  ownerUserId      String         @map("owner_user_id") @db.Uuid
  needsSeatChoice  Boolean        @default(false) @map("needs_seat_choice")
  configAppliedAt  DateTime?      @map("config_applied_at") @db.Timestamptz
  onboarding       Json           @default("{}")
  /// Signup answers: business type, team size, goals … (contracts/workspace.ts WorkspaceProfile)
  profile          Json           @default("{}")
  /// Documents, payments, taxes and branding (contracts/workspace.ts WorkspacePreferences)
  preferences      Json           @default("{}")
  closedAt         DateTime?      @map("closed_at") @db.Timestamptz
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  branches     Branch[]
  members      TenantMember[]
  subscription Subscription?
  acquisition  TenantAcquisition?
  partner      Partner?           @relation(fields: [partnerId], references: [id], map: "tenants_partner_fkey")

  @@index([partnerId])
  @@index([status])
  @@index([source])
  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String
  address   Json?
  stateCode String?  @map("state_code") @db.Char(2)
  gstin     String?  @db.VarChar(15)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("branches")
}

model TenantMember {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  roleId        String       @map("role_id") @db.Uuid
  branchIds     String[]     @default([]) @map("branch_ids") @db.Uuid
  status        MemberStatus @default(invited)
  joinedAt      DateTime?    @map("joined_at") @db.Timestamptz
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz
  version       Int          @default(1)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId, roleId])
  @@index([userId])
  @@map("tenant_members")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String?
  email      String?
  mobile     String?   @db.VarChar(15)
  roleId     String    @map("role_id") @db.Uuid
  branchIds  String[]  @default([]) @map("branch_ids") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("invitations")
}

/// Platform table (no RLS, never visible to tenants): a member of the AHEAD team in the Console.
/// reportsTo builds the sales hierarchy used by the "team" scope.
model PlatformMember {
  id            String       @id @default(uuid(7)) @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  roleId        String       @map("role_id") @db.Uuid
  reportsTo     String?      @map("reports_to") @db.Uuid // user id of the manager
  status        MemberStatus @default(active)
  createdBy     String?      @map("created_by") @db.Uuid
  joinedAt      DateTime     @default(now()) @map("joined_at") @db.Timestamptz
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz
  /// Set for partner people: they only ever see that partner's clients
  partnerId     String?      @map("partner_id") @db.Uuid
  /// Vendors and salespeople: signups with this code are credited to them
  referralCode  String?      @unique(map: "platform_members_referral_code_key") @map("referral_code") @db.VarChar(20)

  user    User     @relation(fields: [userId], references: [id])
  role    Role     @relation(fields: [roleId], references: [id])
  partner Partner? @relation(fields: [partnerId], references: [id], map: "platform_members_partner_fkey")

  @@index([reportsTo])
  @@index([partnerId], map: "platform_members_partner_idx")
  @@map("platform_members")
}

/// A reseller that brings its own clients; AHEAD bills it monthly at list price minus discountBp.
model Partner {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  contactName String   @map("contact_name")
  email       String
  mobile      String   @db.VarChar(15)
  gstin       String?  @db.VarChar(15)
  stateCode   String?  @map("state_code") @db.Char(2)
  discountBp  Int      @default(0) @map("discount_bp")
  status      String   @default("active")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  members PlatformMember[]
  tenants Tenant[]

  @@map("partners")
}

/// What a Console extension changed: the trial end (trialing) or the payment grace end (past_due)
enum ExtensionKind {
  trial
  grace

  @@map("extension_kind")
}

/// Platform table: extra days given from the Console (design v2 §3), always with a reason.
model GracePeriod {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  kind          ExtensionKind
  days          Int
  reason        String
  previousEndAt DateTime?     @map("previous_end_at") @db.Timestamptz
  newEndAt      DateTime      @map("new_end_at") @db.Timestamptz
  grantedBy     String        @map("granted_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@map("grace_periods")
}

enum PlatformOrderStatus {
  pending_approval // discount above the creator's limit; a Super Admin must approve
  awaiting_payment
  paid
  cancelled

  @@map("platform_order_status")
}

enum PlatformPaymentMethod {
  bank_transfer
  upi
  cheque
  cash
  razorpay

  @@map("platform_payment_method")
}

/// Platform table: what AHEAD sells to a client (plan + add-ons + users), priced and taxed once.
model PlatformOrder {
  id               String              @id @default(uuid(7)) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  kind             String              @default("fresh") // fresh | renewal | upgrade
  status           PlatformOrderStatus @default(awaiting_payment)
  planId           String              @map("plan_id") @db.Uuid
  cycle            BillingCycle
  items            Json // [{ itemType, itemRef, priceId, quantity, unitPaise, amountPaise, description }]
  listPaise        BigInt              @map("list_paise")
  discountBp       Int                 @default(0) @map("discount_bp") // sales discount, basis points
  couponCode       String?             @map("coupon_code")
  discountPaise    BigInt              @default(0) @map("discount_paise") // sales discount + coupon
  taxablePaise     BigInt              @map("taxable_paise")
  cgstPaise        BigInt              @default(0) @map("cgst_paise")
  sgstPaise        BigInt              @default(0) @map("sgst_paise")
  igstPaise        BigInt              @default(0) @map("igst_paise")
  totalPaise       BigInt              @map("total_paise")
  billTo           Json                @map("bill_to") // name, gstin, stateCode, address at order time
  createdBy        String              @map("created_by") @db.Uuid
  approvedBy       String?             @map("approved_by") @db.Uuid
  approvedAt       DateTime?           @map("approved_at") @db.Timestamptz
  cancelledReason  String?             @map("cancelled_reason")
  expiresAt        DateTime            @map("expires_at") @db.Timestamptz
  paidAt           DateTime?           @map("paid_at") @db.Timestamptz
  paymentLinkId    String?             @unique @map("payment_link_id")
  paymentLinkUrl   String?             @map("payment_link_url")
  paymentLinkAt    DateTime?           @map("payment_link_at") @db.Timestamptz
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz

  payments PlatformPayment[]
  invoice  PlatformInvoice?

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("platform_orders")
}

/// Platform table: money AHEAD received. Offline payments are recorded by Finance; gateway ones arrive by webhook.
model PlatformPayment {
  id               String                @id @default(uuid(7)) @db.Uuid
  orderId          String                @map("order_id") @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  method           PlatformPaymentMethod
  amountPaise      BigInt                @map("amount_paise")
  reference        String?
  gatewayPaymentId String?               @unique @map("gateway_payment_id")
  receivedAt       DateTime              @map("received_at") @db.Timestamptz
  recordedBy       String?               @map("recorded_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz

  order PlatformOrder @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@map("platform_payments")
}

/// Platform table: AHEAD's GST invoice to a client. Numbered only when paid; never edited.
model PlatformInvoice {
  id           String   @id @default(uuid(7)) @db.Uuid
  number       String   @unique // AHD/26-27/000123
  fy           String
  tenantId     String   @map("tenant_id") @db.Uuid
  orderId      String   @unique @map("order_id") @db.Uuid
  seller       Json // AHEAD billing details at issue time
  billTo       Json     @map("bill_to")
  lines        Json // [{ description, sac, quantity, taxablePaise, cgstPaise, sgstPaise, igstPaise, totalPaise }]
  taxablePaise BigInt   @map("taxable_paise")
  cgstPaise    BigInt   @map("cgst_paise")
  sgstPaise    BigInt   @map("sgst_paise")
  igstPaise    BigInt   @map("igst_paise")
  totalPaise   BigInt   @map("total_paise")
  issuedAt     DateTime @default(now()) @map("issued_at") @db.Timestamptz

  order PlatformOrder @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@map("platform_invoices")
}

/// Platform table: AHEAD's credit note against its own invoice (refunds). Never edited.
model PlatformCreditNote {
  id           String   @id @default(uuid(7)) @db.Uuid
  number       String   @unique // CN/26-27/000001
  fy           String
  tenantId     String   @map("tenant_id") @db.Uuid
  invoiceId    String   @unique @map("invoice_id") @db.Uuid // v1: one full credit note per invoice
  reason       String
  taxablePaise BigInt   @map("taxable_paise")
  cgstPaise    BigInt   @map("cgst_paise")
  sgstPaise    BigInt   @map("sgst_paise")
  igstPaise    BigInt   @map("igst_paise")
  totalPaise   BigInt   @map("total_paise")
  createdBy    String   @map("created_by") @db.Uuid
  issuedAt     DateTime @default(now()) @map("issued_at") @db.Timestamptz

  @@index([tenantId])
  @@map("platform_credit_notes")
}

/// Platform table: every gateway webhook, stored once by its event id (idempotency).
model WebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  gateway     String
  eventId     String    @unique @map("event_id")
  type        String
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  error       String?

  @@map("webhook_events")
}

/// Platform table: AHEAD's own document number series per financial year.
model PlatformSequence {
  docType String @map("doc_type")
  fy      String
  nextNo  Int    @default(1) @map("next_no")

  @@id([docType, fy])
  @@map("platform_sequences")
}

/// Platform table (no RLS, never visible to tenants): who brought the tenant in.
/// Written once by createTenant() and locked; only a Super Admin may change it, with a reason.
model TenantAcquisition {
  tenantId         String            @id @map("tenant_id") @db.Uuid
  acquiredByType   AcquiredByType    @map("acquired_by_type")
  acquiredByUserId String?           @map("acquired_by_user_id") @db.Uuid
  method           AcquisitionMethod
  referralCode     String?           @map("referral_code")
  couponCode       String?           @map("coupon_code")
  lockedAt         DateTime          @default(now()) @map("locked_at") @db.Timestamptz
  changedBy        String?           @map("changed_by") @db.Uuid
  changeReason     String?           @map("change_reason")
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([acquiredByUserId])
  @@map("tenant_acquisitions")
}

/// Platform table (no RLS): prevents repeated trials by the same business.
model TrialRegistry {
  id         String   @id @default(uuid(7)) @db.Uuid
  mobileHash String?  @map("mobile_hash")
  emailHash  String?  @map("email_hash")
  gstin      String?  @db.VarChar(15)
  tenantId   String   @map("tenant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([mobileHash])
  @@index([emailHash])
  @@index([gstin])
  @@map("trial_registry")
}

// ─────────────────────── Roles & permissions ───────────────────────

model Permission {
  key         String           @id // module.resource.action
  moduleKey   String           @map("module_key")
  resource    String
  action      PermissionAction
  description String

  @@map("permissions")
}

model Role {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid // null = predefined
  key             String
  name            String
  description     String?
  layer           RoleLayer
  roleType        RoleType  @map("role_type")
  requiredModules String[]  @default([]) @map("required_modules")
  isSystem        Boolean   @default(false) @map("is_system")
  isPredefined    Boolean   @default(false) @map("is_predefined")
  clonedFrom      String?   @map("cloned_from") @db.Uuid
  templateVersion Int       @default(1) @map("template_version")
  sort            Int       @default(0)
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  permissions     RolePermission[]
  fieldAccess     RoleFieldAccess[]
  members         TenantMember[]
  platformMembers PlatformMember[]

  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId        String          @map("role_id") @db.Uuid
  tenantId      String?         @map("tenant_id") @db.Uuid
  permissionKey String          @map("permission_key")
  scope         PermissionScope @default(all)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model RoleFieldAccess {
  id       String      @id @default(uuid(7)) @db.Uuid
  roleId   String      @map("role_id") @db.Uuid
  tenantId String?     @map("tenant_id") @db.Uuid
  entity   String
  field    String
  access   FieldAccess @default(hidden)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, entity, field])
  @@map("role_field_access")
}

model TenantRoleSetting {
  tenantId String  @map("tenant_id") @db.Uuid
  roleId   String  @map("role_id") @db.Uuid
  hidden   Boolean @default(false)

  @@id([tenantId, roleId])
  @@map("tenant_role_settings")
}

// ─────────────────────── Configuration engine ───────────────────────

model IndustryTemplate {
  key         String   @db.VarChar(40)
  version     Int
  name        String
  description String?
  definition  Json
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz

  @@id([key, version])
  @@map("industry_templates")
}

model TenantTerm {
  tenantId String       @map("tenant_id") @db.Uuid
  termKey  String       @map("term_key")
  value    String
  source   RecordSource @default(template)

  @@id([tenantId, termKey])
  @@map("tenant_terms")
}

model FieldDefinition {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  entity         String
  key            String
  label          String
  type           FieldType
  required       Boolean      @default(false)
  options        Json?
  validation     Json?
  relationEntity String?      @map("relation_entity")
  position       Int          @default(0)
  source         RecordSource @default(tenant)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, entity, key])
  @@map("field_definitions")
}

model FormLayout {
  tenantId String @map("tenant_id") @db.Uuid
  entity   String
  layout   Json

  @@id([tenantId, entity])
  @@map("form_layouts")
}

// ───────────────── Plans, subscriptions & entitlements ─────────────────

/// Platform table: values for settings defined in contracts/config.ts. scope = 'platform' for now.
model ConfigValue {
  scope     String
  key       String
  value     Json
  version   Int      @default(1)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([scope, key])
  @@map("config_values")
}

model Module {
  key          String   @id
  name         String
  description  String?
  category     String
  dependsOn    String[] @default([]) @map("depends_on")
  isFreeTier   Boolean  @default(false) @map("is_free_tier")
  isUsageBased Boolean  @default(false) @map("is_usage_based")
  isV1         Boolean  @default(true) @map("is_v1")
  sort         Int      @default(0)

  @@map("modules")
}

model Plan {
  id       String  @id @default(uuid(7)) @db.Uuid
  key      String  @unique
  name     String
  tagline  String?
  limits   Json
  isPublic Boolean @default(true) @map("is_public")
  sort     Int     @default(0)

  modules PlanModule[]

  @@map("plans")
}

model PlanModule {
  planId    String @map("plan_id") @db.Uuid
  moduleKey String @map("module_key")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, moduleKey])
  @@map("plan_modules")
}

model Price {
  id          String        @id @default(uuid(7)) @db.Uuid
  itemType    PriceItemType @map("item_type")
  itemRef     String        @map("item_ref") // plan key / module key / 'user' / pack key
  cycle       BillingCycle
  amountPaise BigInt        @map("amount_paise")
  activeFrom  DateTime      @default(now()) @map("active_from") @db.Timestamptz
  activeTo    DateTime?     @map("active_to") @db.Timestamptz

  @@index([itemType, itemRef, cycle])
  @@map("prices")
}

model Coupon {
  code           String     @id
  type           CouponType
  value          Int
  appliesTo      String     @default("all") @map("applies_to")
  validFrom      DateTime?  @map("valid_from") @db.Timestamptz
  validTo        DateTime?  @map("valid_to") @db.Timestamptz
  maxRedemptions Int?       @map("max_redemptions")
  redeemed       Int        @default(0)
  vendorId       String?    @map("vendor_id") @db.Uuid

  @@map("coupons")
}

model Subscription {
  id                 String       @id @default(uuid(7)) @db.Uuid
  tenantId           String       @unique @map("tenant_id") @db.Uuid
  planId             String       @map("plan_id") @db.Uuid
  status             TenantStatus
  cycle              BillingCycle @default(monthly)
  trialEndsAt        DateTime?    @map("trial_ends_at") @db.Timestamptz
  currentPeriodStart DateTime?    @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime?    @map("current_period_end") @db.Timestamptz
  graceEndsAt        DateTime?    @map("grace_ends_at") @db.Timestamptz
  cancelAtPeriodEnd  Boolean      @default(false) @map("cancel_at_period_end")
  autoRenew          Boolean      @default(true) @map("auto_renew")
  mandateId          String?      @map("mandate_id") @db.Uuid
  purgeAt            DateTime?    @map("purge_at") @db.Timestamptz
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  items            SubscriptionItem[]
  scheduledChanges ScheduledChange[]

  @@index([status, trialEndsAt])
  @@map("subscriptions")
}

model SubscriptionItem {
  id              String    @id @default(uuid(7)) @db.Uuid
  subscriptionId  String    @map("subscription_id") @db.Uuid
  priceId         String    @map("price_id") @db.Uuid
  quantity        Int       @default(1)
  unitAmountPaise BigInt    @map("unit_amount_paise")
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  endsAt          DateTime? @map("ends_at") @db.Timestamptz

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_items")
}

model ScheduledChange {
  id             String    @id @default(uuid(7)) @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  change         Json
  effectiveAt    DateTime  @map("effective_at") @db.Timestamptz
  appliedAt      DateTime? @map("applied_at") @db.Timestamptz

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("scheduled_changes")
}

model TenantEntitlement {
  tenantId    String            @map("tenant_id") @db.Uuid
  moduleKey   String            @map("module_key")
  status      EntitlementStatus
  limits      Json              @default("{}")
  activatedAt DateTime?         @map("activated_at") @db.Timestamptz // first time active ⇒ "ever used"
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([tenantId, moduleKey])
  @@map("tenant_entitlements")
}

model UsageCounter {
  tenantId String @map("tenant_id") @db.Uuid
  metric   String
  period   String // YYYY-MM
  used     BigInt @default(0)

  @@id([tenantId, metric, period])
  @@map("usage_counters")
}

model CreditBalance {
  tenantId  String    @map("tenant_id") @db.Uuid
  type      String // ai | sms | whatsapp
  balance   BigInt    @default(0)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  @@id([tenantId, type])
  @@map("credit_balances")
}

// ─────────────────────── Events, audit, notifications ───────────────────────

model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  type        String
  version     Int       @default(1) @db.SmallInt
  payload     Json
  actor       Json
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumer, eventId])
  @@map("processed_events")
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  actorKind String   @map("actor_kind") // user | system | platform
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  requestId String?  @map("request_id")
  at        DateTime @default(now()) @db.Timestamptz

  @@index([tenantId, at(sort: Desc)])
  @@map("audit_log")
}

model NotificationLog {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String?  @map("tenant_id") @db.Uuid
  template String
  channel  String
  dedupKey String?  @unique @map("dedup_key")
  target   String?
  status   String   @default("sent")
  sentAt   DateTime @default(now()) @map("sent_at") @db.Timestamptz

  @@index([tenantId])
  @@map("notification_log")
}

/// In-app notifications (AUT-01)
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ═════════════════════════ Business modules — Phase 1 (free core) ═════════════════════════
// Every table below carries tenant_id and is protected by RLS (migration *_phase1_modules).

enum ItemType {
  product
  service

  @@map("item_type")
}

enum ContactType {
  lead
  customer

  @@map("contact_type")
}

enum LeadStatus {
  new
  contacted
  qualified
  lost
  converted

  @@map("lead_status")
}

enum ActivityType {
  note
  call
  meeting
  follow_up

  @@map("activity_type")
}

enum SalesDocKind {
  quotation
  invoice

  @@map("sales_doc_kind")
}

enum SalesDocStatus {
  draft
  sent
  accepted
  declined
  converted
  issued
  partially_paid
  paid
  cancelled

  @@map("sales_doc_status")
}

enum PaymentMethod {
  cash
  upi
  card
  bank
  cheque
  other

  @@map("payment_method")
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled

  @@map("task_status")
}

enum TaskPriority {
  low
  medium
  high
  urgent

  @@map("task_priority")
}

enum AppointmentKind {
  appointment
  event

  @@map("appointment_kind")
}

enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show

  @@map("appointment_status")
}

// ── Product & Service Catalogue (CAT-01, CAT-02) ──

model ItemCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, name])
  @@map("item_categories")
}

model Item {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  type           ItemType     @default(product)
  name           String
  sku            String?
  categoryId     String?      @map("category_id") @db.Uuid
  unit           String       @default("pcs")
  pricePaise     BigInt       @default(0) @map("price_paise")
  costPricePaise BigInt?      @map("cost_price_paise")
  gstRateBp      Int          @default(1800) @map("gst_rate_bp") // 1800 = 18%
  hsnSac         String?      @map("hsn_sac") @db.VarChar(10)
  durationMin    Int?         @map("duration_min")
  skill          String?
  description    String?
  imageUrl       String?      @map("image_url")
  isActive       Boolean      @default(true) @map("is_active")
  custom         Json         @default("{}")
  source         RecordSource @default(tenant)
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  version        Int          @default(1)

  @@index([tenantId, name])
  @@map("items")
}

// ── CRM (CRM-01..04) ──

model Contact {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  branchId    String?     @map("branch_id") @db.Uuid
  type        ContactType @default(customer)
  name        String
  companyName String?     @map("company_name")
  phone       String?     @db.VarChar(15)
  email       String?
  gstin       String?     @db.VarChar(15)
  stateCode   String?     @map("state_code") @db.Char(2)
  address     Json?
  leadStatus  LeadStatus? @map("lead_status")
  leadSource  String?     @map("lead_source")
  ownerId     String?     @map("owner_id") @db.Uuid
  isActive    Boolean     @default(true) @map("is_active")
  notes       String?
  custom      Json        @default("{}")
  /// Created by "Try with sample data"; removed together from Settings › Data
  isSample    Boolean     @default(false) @map("is_sample")
  createdBy   String?     @map("created_by") @db.Uuid
  convertedAt DateTime?   @map("converted_at") @db.Timestamptz
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  version     Int         @default(1)

  @@index([tenantId, type, name])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@map("contacts")
}

model Activity {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  contactId   String       @map("contact_id") @db.Uuid
  type        ActivityType
  title       String?
  body        String?
  dueAt       DateTime?    @map("due_at") @db.Timestamptz
  completedAt DateTime?    @map("completed_at") @db.Timestamptz
  assigneeId  String?      @map("assignee_id") @db.Uuid
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, contactId, createdAt(sort: Desc)])
  @@index([tenantId, assigneeId, dueAt])
  @@map("activities")
}

// ── Quotations & GST invoices (SAL-01, BIL-01..04) ──

model TenantSequence {
  tenantId String @map("tenant_id") @db.Uuid
  docType  String @map("doc_type") // invoice | quotation | receipt
  fy       String // e.g. 26-27
  prefix   String
  nextNo   Int    @default(1) @map("next_no")

  @@id([tenantId, docType, fy])
  @@map("tenant_sequences")
}

model SalesDocument {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  branchId      String?        @map("branch_id") @db.Uuid
  kind          SalesDocKind
  status        SalesDocStatus @default(draft)
  number        String?
  fy            String?
  contactId     String?        @map("contact_id") @db.Uuid
  buyer         Json           @default("{}") // snapshot: name, gstin, phone, email, address, stateCode
  seller        Json? // snapshot at issue: name, legalName, gstin, address, stateCode
  placeOfSupply String?        @map("place_of_supply") @db.Char(2)
  issueDate     DateTime       @map("issue_date") @db.Date
  dueDate       DateTime?      @map("due_date") @db.Date
  subtotalPaise BigInt         @default(0) @map("subtotal_paise")
  discountPaise BigInt         @default(0) @map("discount_paise")
  taxablePaise  BigInt         @default(0) @map("taxable_paise")
  cgstPaise     BigInt         @default(0) @map("cgst_paise")
  sgstPaise     BigInt         @default(0) @map("sgst_paise")
  igstPaise     BigInt         @default(0) @map("igst_paise")
  totalPaise    BigInt         @default(0) @map("total_paise")
  paidPaise     BigInt         @default(0) @map("paid_paise")
  notes         String?
  terms         String?
  sourceType    String?        @map("source_type") // quotation | appointment
  sourceId      String?        @map("source_id") @db.Uuid
  shareToken    String?        @unique @map("share_token")
  custom        Json           @default("{}")
  createdBy     String?        @map("created_by") @db.Uuid
  issuedAt      DateTime?      @map("issued_at") @db.Timestamptz
  cancelledAt   DateTime?      @map("cancelled_at") @db.Timestamptz
  cancelReason  String?        @map("cancel_reason")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  version       Int            @default(1)

  lines    SalesDocumentLine[]
  payments Payment[]

  @@unique([tenantId, kind, number])
  @@index([tenantId, kind, status, issueDate])
  @@index([tenantId, contactId])
  @@map("sales_documents")
}

model SalesDocumentLine {
  id             String  @id @default(uuid(7)) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  documentId     String  @map("document_id") @db.Uuid
  itemId         String? @map("item_id") @db.Uuid
  description    String
  hsnSac         String? @map("hsn_sac") @db.VarChar(10)
  unit           String  @default("pcs")
  quantity       Decimal @db.Decimal(18, 3)
  unitPricePaise BigInt  @map("unit_price_paise")
  discountPaise  BigInt  @default(0) @map("discount_paise")
  taxablePaise   BigInt  @map("taxable_paise")
  gstRateBp      Int     @map("gst_rate_bp")
  cgstPaise      BigInt  @default(0) @map("cgst_paise")
  sgstPaise      BigInt  @default(0) @map("sgst_paise")
  igstPaise      BigInt  @default(0) @map("igst_paise")
  totalPaise     BigInt  @map("total_paise")
  position       Int     @default(0)

  document SalesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@map("sales_document_lines")
}

model Payment {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  documentId  String        @map("document_id") @db.Uuid
  contactId   String?       @map("contact_id") @db.Uuid
  number      String
  amountPaise BigInt        @map("amount_paise")
  method      PaymentMethod
  reference   String?
  paidOn      DateTime      @map("paid_on") @db.Date
  notes       String?
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  document SalesDocument @relation(fields: [documentId], references: [id])

  @@index([tenantId, documentId])
  @@index([tenantId, paidOn])
  @@map("payments_received")
}

// ── Expenses (FIN-01) ──

model Expense {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  branchId    String?       @map("branch_id") @db.Uuid
  category    String
  amountPaise BigInt        @map("amount_paise")
  paidOn      DateTime      @map("paid_on") @db.Date
  method      PaymentMethod @default(cash)
  payee       String?
  notes       String?
  receiptUrl  String?       @map("receipt_url")
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  version     Int           @default(1)

  @@index([tenantId, paidOn])
  @@map("expenses")
}

// ── Tasks (TSK-01, TSK-02) ──

model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  parentId    String?      @map("parent_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueAt       DateTime?    @map("due_at") @db.Timestamptz
  assigneeId  String?      @map("assignee_id") @db.Uuid
  contactId   String?      @map("contact_id") @db.Uuid
  createdBy   String?      @map("created_by") @db.Uuid
  completedAt DateTime?    @map("completed_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  version     Int          @default(1)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, assigneeId])
  @@index([tenantId, parentId])
  @@map("tasks")
}

model TaskEvent {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  taskId   String   @map("task_id") @db.Uuid
  actorId  String?  @map("actor_id") @db.Uuid
  type     String // created | status | assigned | comment | edited
  body     String?
  data     Json?
  at       DateTime @default(now()) @db.Timestamptz

  @@index([tenantId, taskId, at])
  @@map("task_events")
}

// ── Calendar & bookings (BKG-01, BKG-02, BKG-08) ──

model Appointment {
  id        String            @id @default(uuid(7)) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  branchId  String?           @map("branch_id") @db.Uuid
  kind      AppointmentKind   @default(appointment)
  title     String
  contactId String?           @map("contact_id") @db.Uuid
  itemId    String?           @map("item_id") @db.Uuid
  staffId   String?           @map("staff_id") @db.Uuid
  startAt   DateTime          @map("start_at") @db.Timestamptz
  endAt     DateTime          @map("end_at") @db.Timestamptz
  status    AppointmentStatus @default(scheduled)
  notes     String?
  invoiceId String?           @map("invoice_id") @db.Uuid
  createdBy String?           @map("created_by") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  version   Int               @default(1)

  @@index([tenantId, startAt])
  @@index([tenantId, staffId, startAt])
  @@map("appointments")
}

// ── Phase 2: account security (platform tables) ──

model UserMfa {
  userId         String    @id @map("user_id") @db.Uuid
  secretEnc      String    @map("secret_enc")
  enabledAt      DateTime? @map("enabled_at") @db.Timestamptz
  /// [{ hash, usedAt }] — one-time recovery codes
  backupCodes    Json      @default("[]") @map("backup_codes")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

model UserTrustedDevice {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_trusted_devices")
}

model UserPasswordHistory {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_password_history")
}

model SignInEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  /// Masked email/mobile when no account matched
  identifier String?
  /// success | wrong_password | locked | mfa_challenge | mfa_failed | blocked_ip | expired_password
  outcome    String
  method     String?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("sign_in_events")
}

// ── Phase 4: Console sales workspace (platform tables) ──

model ConsoleProspect {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  businessName String   @map("business_name")
  industryKey  String?  @map("industry_key")
  city         String?
  mobile       String?  @db.VarChar(15)
  email        String?
  source       String?
  /// new | contacted | demo | trial | won | lost
  stage        String   @default("new")
  lostReason   String?  @map("lost_reason")
  ownerUserId  String   @map("owner_user_id") @db.Uuid
  /// The business once it signs up (self or from the Console)
  tenantId     String?  @map("tenant_id") @db.Uuid
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  followups ConsoleFollowup[]
  notes     ConsoleNote[]

  @@index([ownerUserId, stage], map: "console_prospects_owner_idx")
  @@index([mobile], map: "console_prospects_mobile_idx")
  @@index([tenantId], map: "console_prospects_tenant_idx")
  @@map("console_prospects")
}

model ConsoleFollowup {
  id          String    @id @default(uuid(7)) @db.Uuid
  prospectId  String?   @map("prospect_id") @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  title       String
  dueAt       DateTime  @map("due_at") @db.Timestamptz
  ownerUserId String    @map("owner_user_id") @db.Uuid
  doneAt      DateTime? @map("done_at") @db.Timestamptz
  autoKey     String?   @unique(map: "console_followups_auto_key") @map("auto_key")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  prospect ConsoleProspect? @relation(fields: [prospectId], references: [id], onDelete: Cascade, map: "console_followups_prospect_fkey")

  @@index([ownerUserId, doneAt, dueAt], map: "console_followups_owner_idx")
  @@index([tenantId], map: "console_followups_tenant_idx")
  @@map("console_followups")
}

model ConsoleNote {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  prospectId    String?  @map("prospect_id") @db.Uuid
  body          String
  privateToTeam Boolean  @default(false) @map("private_to_team")
  authorId      String   @map("author_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  prospect ConsoleProspect? @relation(fields: [prospectId], references: [id], onDelete: Cascade, map: "console_notes_prospect_fkey")

  @@index([tenantId, createdAt(sort: Desc)], map: "console_notes_tenant_idx")
  @@map("console_notes")
}
