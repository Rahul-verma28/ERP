PORT=5000
NODE_ENV=development

# Neon: pooled URL for the app, direct URL for migrations.
# Neon is reached over WebSockets on port 443 (works on networks that block 5432).
# Set DB_TRANSPORT=tcp to use a plain TCP connection instead (e.g. local Postgres).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`)
JWT_SECRET=
PEPPER=

# Frontend origin (used in email links and CORS)
APP_URL=http://localhost:3000

# Razorpay payment links (optional in development: without keys a built-in test gateway is used).
# Webhook URL to register in the Razorpay dashboard: <API origin>/api/v1/webhooks/razorpay (event: payment_link.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to false to run the API without the in-process worker (outbox relay + scheduled jobs)
RUN_WORKER=true

# Dev-only test Console Admin (created with npm run console:member, dev database only)
# DEV_TEST_ADMIN=v3admin@example.test / Ahead-v3-Console-2026
# DEV_TEST_PARTNER_OWNER=anil.v3test@example.test / Partner-v3-Portal-2026
# DEV_TEST_HANDOVER_OWNER=kavita.wiztest@example.test / Owner-v3-Handover-2026 (business "Wizard Test Mart")
