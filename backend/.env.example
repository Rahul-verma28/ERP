PORT=5000
NODE_ENV=development

# PostgreSQL 16+: on this computer in development, the PostgreSQL container in production.
# npm run dev creates the database if it is missing, applies migrations and syncs reference data.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/ahead_erp

# Where uploaded photos and documents are kept. With S3_BUCKET set they go to Amazon S3
# (or Cloudflare R2: also set S3_ENDPOINT); otherwise to STORAGE_DIR (default: backend/storage).
# STORAGE_DIR=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Email over SMTP. Gmail: smtp.gmail.com, port 465, and an app password (Google account › Security ›
# App passwords). Empty: emails are only written to the server log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AHEAD ERP <you@example.com>"

# SMS through textbee.dev: an API key from its dashboard, and the textbee app on an Android phone
# registered with that key. Empty: SMS is only written to the server log.
TEXTBEE_API_KEY=

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`)
JWT_SECRET=
PEPPER=

# Frontend origin (used in email links and CORS)
APP_URL=http://localhost:3000

# Razorpay payment links (optional in development: without keys a built-in test gateway is used).
# Webhook URL to register in the Razorpay dashboard: <API origin>/api/v1/webhooks/razorpay (event: payment_link.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Licences and signed Console <-> ERP calls (docs/architecture/console-erp-split.md).
# npm run licence:keys prints all three. LICENCE_PRIVATE_KEY only where the Console runs.
LICENCE_PUBLIC_KEY=
LICENCE_PRIVATE_KEY=
PROVISION_KEY=
DEPLOYMENT_ID=cloud-dev

# Set to false to run the API without the in-process worker (outbox relay + scheduled jobs)
RUN_WORKER=true

# Dev-only test Console Admin (created with npm run console:member, dev database only)
# DEV_TEST_ADMIN=v3admin@example.test / Ahead-v3-Console-2026
# DEV_TEST_PARTNER_OWNER=anil.v3test@example.test / Partner-v3-Portal-2026
# DEV_TEST_HANDOVER_OWNER=kavita.wiztest@example.test / Owner-v3-Handover-2026 (business "Wizard Test Mart")
