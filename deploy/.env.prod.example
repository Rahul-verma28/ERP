# Production values for deploy/docker-compose.prod.yml. Copy to .env on the server; never commit it.
# Make secrets with: openssl rand -base64 48
ERP_DOMAIN=erp.example.com
CONSOLE_DOMAIN=console.example.com
POSTGRES_PASSWORD=
ERP_JWT_SECRET=
ERP_PEPPER=
CONSOLE_JWT_SECRET=
CONSOLE_PEPPER=
# 32 bytes, base64: openssl rand -base64 32
MFA_KEY=
# Shared by both APIs for signed calls (32+ characters)
PROVISION_KEY=
DEPLOYMENT_ID=cloud
# Licence key pair: cd console-api && npm run licence:keys
LICENCE_PRIVATE_KEY=
LICENCE_PUBLIC_KEY=
# Email, SMS and files
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
TEXTBEE_API_KEY=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Razorpay live keys; webhook URL https://<CONSOLE_DOMAIN>/api/v1/webhooks/razorpay, event payment_link.paid
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
