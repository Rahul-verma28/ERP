# Copy to .env next to docker-compose.yml and fill in. Never commit the real file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB_NAME=ahead_erp
# At least 32 and 16 random characters
JWT_SECRET=change-me-at-least-32-random-characters
PEPPER=change-me-16-plus
APP_URL=http://localhost:3000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
